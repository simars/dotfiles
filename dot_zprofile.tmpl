# 1. Architecture-Aware Homebrew Initialization (macOS)
{{ if eq .chezmoi.os "darwin" -}}
if [[ -x "/opt/homebrew/bin/brew" ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x "/usr/local/bin/brew" ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi
{{ end -}}

# 2. User Binaries & Mise Shims
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"

# 3. macOS Docker Socket Routing
{{ if eq .chezmoi.os "darwin" -}}
# Prefer Colima socket if actively running, else allow Docker Desktop
if [[ -S "${HOME}/.colima/default/docker.sock" ]]; then
    export DOCKER_HOST="unix://${HOME}/.colima/default/docker.sock"
elif [[ -d "${HOME}/.docker/bin" ]]; then
    export PATH="$PATH:${HOME}/.docker/bin"
fi

# 4. macOS Keychain SSH Identity Preload
ssh-add --apple-load-keychain 2>/dev/null || true
{{ end -}}
