# ==============================================================================
# Interactive Shell Configuration (.zshrc)
# ==============================================================================

# 1. Environment & Paths
export PATH="$HOME/.local/bin:$PATH"

# Architecture-Aware Homebrew
{{ if eq .chezmoi.os "darwin" -}}
if [[ -x "/opt/homebrew/bin/brew" ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x "/usr/local/bin/brew" ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi
{{ end -}}

# Default editor: the first of nvim, vim and vi on PATH; a value already in the environment wins.
# This must run before ~/.aliases is sourced, because `alias e="$EDITOR"` expands when it is defined.
if [[ -z "${EDITOR:-}" ]]; then
    for _editor in nvim vim vi; do
        if command -v "$_editor" &> /dev/null; then
            export EDITOR="$_editor"
            break
        fi
    done
    unset _editor
fi
export VISUAL="${VISUAL:-$EDITOR}"

# Antigravity Binaries & Environment
if [[ -d "$HOME/.antigravity/antigravity/bin" ]]; then
    export PATH="$HOME/.antigravity/antigravity/bin:$PATH"
fi
if [[ -d "$HOME/.antigravity-ide/antigravity-ide/bin" ]]; then
    export PATH="$HOME/.antigravity-ide/antigravity-ide/bin:$PATH"
fi
if [[ -f "$HOME/.local/bin/env" ]]; then
    . "$HOME/.local/bin/env"
fi

# 2. Atlassian Bare Repository Alias (.cfg)
alias config='/usr/bin/git --git-dir=$HOME/.cfg/ --work-tree=$HOME'

# 3. Global Navigation & Tool Aliases
alias ll="ls -lah"
alias g="git"
alias cz="chezmoi"
alias tm="tmux new-session -A -s main"

{{ if eq .chezmoi.os "darwin" -}}
alias flushdns="sudo dscacheutil -flushcache; sudo killall -HUP mDNSResponder"
alias brews="brew update && brew upgrade && brew cleanup && brew autoremove"
alias cz-brew-prune="brew autoremove && brew cleanup -s"
alias cz-update-clt="softwareupdate --all --install --force"
alias d-up="colima start --cpu 4 --memory 8 --disk 40"
alias d-down="colima stop"
{{ else if eq .chezmoi.os "linux" -}}
alias update="sudo apt-get update && sudo apt-get upgrade -y"
{{ end -}}

# Container Helpers
dkill() {
    for d in */; do
        if [[ -f "${d}docker-compose.yml" || -f "${d}docker-compose.yaml" ]]; then
            (cd "$d" && docker compose down)
        fi
    done
}
alias dprune="docker system prune -a --volumes -f"

# 4. History Configuration & Shell Options
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt HIST_IGNORE_ALL_DUPS INC_APPEND_HISTORY SHARE_HISTORY
unsetopt NOMATCH

# 5. Zsh Completions
autoload -Uz compinit && compinit -C

# 6. Shell Integrations (fzf, zoxide, autosuggestions)
if [ -f "$HOME/.oh-my-zsh/custom/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" ]; then
    source "$HOME/.oh-my-zsh/custom/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"
    ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=60'
fi

if command -v fzf &> /dev/null; then
    eval "$(fzf --zsh 2>/dev/null)" || true
fi
if [ -f "$HOME/.fzf.zsh" ]; then
    source "$HOME/.fzf.zsh"
fi

if command -v zoxide &> /dev/null; then
    eval "$(zoxide init zsh 2>/dev/null)" || true
fi

# 7. Polyglot Runtimes (mise) & Starship Prompt
export MISE_ENV_AUTO_RELOAD=1
if command -v mise &> /dev/null; then
    eval "$(mise activate zsh)"
fi

if command -v starship &> /dev/null; then
    eval "$(starship init zsh)"
fi

# 8. Sourcing Local Files & Secrets (if present)
if [[ -f "$HOME/.aliases" ]]; then
    source "$HOME/.aliases"
fi

if [[ -f "$HOME/.zshrc.local" ]]; then
    source "$HOME/.zshrc.local"
fi

# Work-specific env files are sourced from ~/.zshrc.local, not listed here.
env_files=(
    "$HOME/secrets.env"
)
for env_file in "${env_files[@]}"; do
    if [[ -r "$env_file" ]]; then
        source "$env_file"
    fi
done
{{- if eq .chezmoi.os "darwin" }}

# 9. macOS Userland: GNU or Apple command-line tools (`userland` shows the mode; cheatsheet §1)
#   gnu (default): aliases make ls, sed, grep, find, tar, awk, make and the rest of coreutils the GNU versions in this
#       interactive shell only. Scripts and other child processes keep Apple's tools, because macOS scripts that use
#       BSD flags (sed -i '', stat -f, date -v, base64 -D, mktemp -t, dd bs=1m) break under the GNU ones.
#   apple: Apple's tools; GNU only under the g prefix (gsed, gls).
#   gnu-path: the gnubin directories first on PATH, so child processes get GNU too (Linux-minded scripts).
# A host sets its default with MACOS_USERLAND in ~/.zshrc.local, which is why this runs last. The formula list is
# explicit because libtool also ships a gnubin, and GNU libtool in place of Apple's /usr/bin/libtool breaks Xcode builds.
zmodload zsh/parameter 2> /dev/null
typeset -ga _userland_aliased
typeset -gA _userland_saved
typeset -g _userland_mode="${_userland_mode:-apple}"
userland() {
    local mode="${1:-}" prefix="${HOMEBREW_PREFIX:-/opt/homebrew}" formula gnubin cmd value
    local -a gnubins
    for formula in coreutils findutils gawk gnu-sed gnu-tar grep make; do
        gnubin="$prefix/opt/$formula/libexec/gnubin"
        [[ -d "$gnubin" ]] && gnubins+=("$gnubin")
    done
    case "$mode" in
        "") print -r -- "userland: $_userland_mode (switch with: userland gnu|apple|gnu-path)"; return 0 ;;
        gnu | apple | gnu-path) ;;
        *) print -ru2 -- "usage: userland [gnu|apple|gnu-path]"; return 2 ;;
    esac
    # Undo the current mode: drop the aliases it added, restore the ones it rewrote, take gnubin off PATH.
    for cmd in $_userland_aliased; do unalias "$cmd" 2> /dev/null; done
    for cmd in ${(k)_userland_saved}; do aliases[$cmd]="${_userland_saved[$cmd]}"; done
    _userland_aliased=()
    _userland_saved=()
    path=(${path:|gnubins})
    if [[ "$mode" == gnu ]]; then
        for gnubin in $gnubins; do
            for cmd in "$gnubin"/*(N:t); do
                # Only commands macOS also has (the rest are on PATH unprefixed already), and never shell builtins.
                (( $+builtins[$cmd] )) && continue
                [[ -x /bin/$cmd || -x /usr/bin/$cmd || -x /sbin/$cmd || -x /usr/sbin/$cmd ]] || continue
                [[ -x "$prefix/bin/g$cmd" ]] || continue
                if (( $+aliases[$cmd] )); then
                    # zsh does not expand an alias's own name again, so mkdir="mkdir -p" would keep Apple's mkdir:
                    # point such aliases at the GNU tool, and leave aliases to other commands alone.
                    value="${aliases[$cmd]}"
                    [[ "$value" == "$cmd" || "$value" == "$cmd "* ]] || continue
                    _userland_saved[$cmd]="$value"
                    aliases[$cmd]="g$cmd${value#$cmd}"
                else
                    aliases[$cmd]="g$cmd"
                    _userland_aliased+=("$cmd")
                fi
            done
        done
    elif [[ "$mode" == gnu-path ]]; then
        path=($gnubins $path)
    fi
    _userland_mode="$mode"
}
userland "${MACOS_USERLAND:-gnu}"
{{- end }}
