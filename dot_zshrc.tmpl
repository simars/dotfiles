# ==============================================================================
# Interactive Shell Configuration (.zshrc)
# ==============================================================================

# 1. Environment & Paths
export PATH="$HOME/.local/bin:$PATH"
{{- if eq .chezmoi.os "linux" }}

# SSH agent: a tmux or Herdr server started over SSH hands its panes that login's forwarded agent socket, which is
# gone once that login ends, so every ssh and git in them asks for the key's passphrase again. Use GNOME keyring's
# agent (gcr-ssh-agent; it unlocks the key with the passphrase ssh-key-remember saved) when the socket is dead. A
# live socket, forwarded or not, is left alone. Cheatsheet: "SSH Key Passphrase".
if [[ -n "${SSH_AUTH_SOCK:-}" && ! -S "$SSH_AUTH_SOCK" && -S "${XDG_RUNTIME_DIR:-/run/user/$UID}/gcr/ssh" ]]; then
    export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR:-/run/user/$UID}/gcr/ssh"
fi
{{- end }}

# Architecture-Aware Homebrew
{{ if eq .chezmoi.os "darwin" -}}
if [[ -x "/opt/homebrew/bin/brew" ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x "/usr/local/bin/brew" ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi
{{ end -}}
{{ if eq (dig "osRelease" "id" "" .chezmoi) "omarchy" -}}

# Omarchy: ~/.bashrc hands an interactive terminal over to zsh (Omarchy's omarchy-zsh design; the login shell stays
# bash). Interactive shells load what Omarchy's ~/.bashrc loads, in zsh form: the omarchy-zsh package's zsh options,
# then Omarchy's own current envs, aliases and helpers (omarchy-zsh ships older copies of the same shared files).
# Everything after this block still runs and wins: history sizes, tool init, ~/.aliases, ~/.zshrc.local.
if [[ -o interactive && -r /usr/share/omarchy-zsh/shell/zoptions && -r /usr/share/omarchy/default/bash/env-bootstrap ]]; then
    source /usr/share/omarchy/default/bash/env-bootstrap
    source /usr/share/omarchy-zsh/shell/zoptions
    # Variable completion ($VAR<Tab>, export <Tab>) as on every other host: zoptions turns it off. Ctrl+Alt+V still works.
    unfunction _parameters 2> /dev/null && autoload -Uz _parameters
    # Omarchy's Ctrl+Alt+F file search, kept under its own name: fzf's setup (below) redefines fzf-file-widget for Ctrl-T.
    if (( $+functions[fzf-file-widget] )); then
        functions[fzf-find-files-widget]=$functions[fzf-file-widget]
        zle -N fzf-find-files-widget
        bindkey -M emacs '^[^F' fzf-find-files-widget
    fi
    source "$OMARCHY_PATH/default/bash/envs"
    source "$OMARCHY_PATH/default/bash/aliases"
    for _omarchy_fn in "$OMARCHY_PATH"/default/bash/fns/*; do
        case "${_omarchy_fn:t}" in
            ssh-reconnect | drives) ;;
            *) source "$_omarchy_fn" ;;
        esac
    done
    unset _omarchy_fn
    # These two need bash itself (zsh misreads ${letters:i:1} in ssh's reconnect check, and `read -p` in
    # format-drive), so they run there.
    _omarchy_bash() { bash -c 'source "$1"; shift; "$@"' omarchy "$OMARCHY_PATH/default/bash/fns/$1" "${@:2}"; }
    ssh() { _omarchy_bash ssh-reconnect ssh "$@"; }
    iso2sd() { _omarchy_bash drives iso2sd "$@"; }
    format-drive() { _omarchy_bash drives format-drive "$@"; }
    if command -v try &> /dev/null; then
        try() { unfunction try; eval "$(SHELL=/usr/bin/zsh command try init ~/Work/tries)"; try "$@"; }
    fi
    # Programs started from here (tmux, herdr, nvim's terminal) open zsh; Claude Code keeps bash, as on the Macs.
    export SHELL=/usr/bin/zsh
    export CLAUDE_CODE_SHELL=/usr/bin/bash
fi
{{ else -}}

# Without Omarchy: Omarchy's portable helpers and keys, generated from its own files by chezmoi (cx, t, h, ff, sff, ga,
# gd, fip, tdl, hdl, Ctrl+Alt+F/L/V and the rest; the file lists what is left out), and man pages through bat.
if [[ -o interactive && -r "$HOME/.config/zsh/shared-helpers.zsh" ]]; then
    source "$HOME/.config/zsh/shared-helpers.zsh"
fi
if [[ -o interactive ]] && (( $+commands[bat] )); then
    export MANROFFOPT="-c"
    export MANPAGER="sh -c 'col -bx | bat -l man -p'"
fi
{{ end -}}

# Default editor: the first of nvim, vim and vi on PATH; a value already in the environment wins.
# This must run before ~/.aliases is sourced, because `alias e="$EDITOR"` expands when it is defined.
if [[ -z "${EDITOR:-}" ]]; then
    for _editor in nvim vim vi; do
        if command -v "$_editor" &> /dev/null; then
            export EDITOR="$_editor"
            break
        fi
    done
    unset _editor
fi
export VISUAL="${VISUAL:-$EDITOR}"

# Antigravity Binaries & Environment
if [[ -d "$HOME/.antigravity/antigravity/bin" ]]; then
    export PATH="$HOME/.antigravity/antigravity/bin:$PATH"
fi
if [[ -d "$HOME/.antigravity-ide/antigravity-ide/bin" ]]; then
    export PATH="$HOME/.antigravity-ide/antigravity-ide/bin:$PATH"
fi
if [[ -f "$HOME/.local/bin/env" ]]; then
    . "$HOME/.local/bin/env"
fi

# 2. Atlassian Bare Repository Alias (.cfg)
alias config='/usr/bin/git --git-dir=$HOME/.cfg/ --work-tree=$HOME'

# 3. Global Navigation & Tool Aliases
alias ll="ls -lah"
alias g="git"
# cz, tm, dkill and dprune live in ~/.aliases, shared with bash.

{{ if eq .chezmoi.os "darwin" -}}
alias flushdns="sudo dscacheutil -flushcache; sudo killall -HUP mDNSResponder"
alias brews="brew update && brew upgrade && brew cleanup && brew autoremove"
alias cz-brew-prune="brew autoremove && brew cleanup -s"
alias cz-update-clt="softwareupdate --all --install --force"
alias d-up="colima start --cpu 4 --memory 8 --disk 40"
alias d-down="colima stop"
{{ else if has (dig "osRelease" "id" "" .chezmoi) (list "ubuntu" "debian") -}}
alias update="sudo apt-get update && sudo apt-get upgrade -y"
{{ end -}}

# 4. History Configuration & Shell Options
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt HIST_IGNORE_ALL_DUPS INC_APPEND_HISTORY SHARE_HISTORY
unsetopt NOMATCH

# 5. Zsh Completions
autoload -Uz compinit && compinit -C

# 5a. Line Editor: the same on every host. These are the settings of Omarchy's own zsh, with vi keys instead of its emacs
# ones; on Omarchy, where its zsh options already set them above, repeating them changes nothing.
if [[ -o interactive ]]; then
    setopt HIST_IGNORE_SPACE HIST_REDUCE_BLANKS HIST_VERIFY # a command typed with a leading space stays out of history
    setopt COMPLETE_IN_WORD ALWAYS_TO_END AUTO_LIST LIST_AMBIGUOUS AUTO_MENU
    unsetopt MENU_COMPLETE BASH_AUTO_LIST BEEP
    setopt AUTO_CD CHASE_LINKS EXTENDED_GLOB INTERACTIVE_COMMENTS COMBINING_CHARS
    setopt NO_HASH_CMDS NO_HASH_DIRS # new commands (mise shims) are found without `rehash`

    # Tab: a highlighted menu, case-insensitive, matching inside words, coloured like ls.
    zmodload zsh/complist
    zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|=* l:|=*'
    zstyle ':completion:*' menu select
    if [[ -z "${LS_COLORS:-}" ]]; then
        if (( $+commands[dircolors] )); then
            eval "$(dircolors -b)"
        elif (( $+commands[gdircolors] )); then
            eval "$(gdircolors -b)"
        fi
    fi
    zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
    zstyle ':completion:*' list-prompt ''
    zstyle ':completion:*' select-prompt ''
    zstyle ':completion:*' match-hidden-files off

    # vi keys: Esc for normal mode. Set explicitly, because zsh otherwise picks vi or emacs from $EDITOR. This switches
    # the main keymap to vi insert, so what was bound in the emacs keymap before (Omarchy's keys) is bound again here,
    # in insert and normal mode: Up/Down search history for what is already typed, Shift-Tab steps back in the menu.
    bindkey -v
    for _keymap in viins vicmd; do
        for _key in '^[[A' '^[OA'; do bindkey -M "$_keymap" "$_key" history-search-backward; done
        for _key in '^[[B' '^[OB'; do bindkey -M "$_keymap" "$_key" history-search-forward; done
    done
    # Alt+Left/Right (left Option on the Macs) jump by word, in the two forms terminals send. Not Esc b / Esc f: in vi
    # mode, Esc then b typed quickly must still mean normal mode and back a word. Without a binding, Esc [1;3D would run
    # as vi commands and its D deletes to the end of the line. tmux and herdr leave these keys to the shell.
    for _keymap in viins vicmd; do
        for _key in '^[[1;3D' '^[^[[D'; do bindkey -M "$_keymap" "$_key" backward-word; done
        for _key in '^[[1;3C' '^[^[[C'; do bindkey -M "$_keymap" "$_key" forward-word; done
    done
    bindkey -M viins '^[[Z' reverse-menu-complete
    bindkey -M menuselect '^[[Z' reverse-menu-complete
    # Omarchy's fzf keys (Ctrl+Alt+F files, Ctrl+Alt+L git log, Ctrl+Alt+V variables), where they are defined.
    if (( $+widgets[fzf-git-log-widget] )); then
        bindkey -M viins '^[^F' fzf-find-files-widget
        bindkey -M viins '^[^L' fzf-git-log-widget
        bindkey -M viins '^[^V' fzf-variables-widget
    fi
    unset _keymap _key
fi

# 6. Shell Integrations (autosuggestions, fzf, zoxide)
# History suggestions as you type (zsh-autosuggestions; → accepts): the system package (Homebrew, Arch, Debian and
# Ubuntu), else an old oh-my-zsh clone. The requirement check after `chezmoi apply` warns when none is installed.
if [[ -o interactive ]]; then
    for _plugin in \
        "${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh-autosuggestions/zsh-autosuggestions.zsh" \
        /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh \
        /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
        "$HOME/.oh-my-zsh/custom/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"; do
        if [[ -r "$_plugin" ]]; then
            source "$_plugin"
            ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=60'
            break
        fi
    done
    unset _plugin
fi

if command -v fzf &> /dev/null; then
    eval "$(fzf --zsh 2>/dev/null)" || true
fi
if [ -f "$HOME/.fzf.zsh" ]; then
    source "$HOME/.fzf.zsh"
fi

if command -v zoxide &> /dev/null; then
    eval "$(zoxide init zsh 2>/dev/null)" || true
fi

# 7. Polyglot Runtimes (mise) & Starship Prompt
export MISE_ENV_AUTO_RELOAD=1
if command -v mise &> /dev/null; then
    eval "$(mise activate zsh)"
fi

if command -v starship &> /dev/null; then
    eval "$(starship init zsh)"
    # Over SSH, the machine's short name (~/.local/bin/host-label) on the right of the prompt line: Starship's right
    # side is unused here, and its prompt starts with a blank line, so a tag on the left would sit on that empty line.
    # Cheatsheet: "Which Machine Am I On".
    [[ -n "${SSH_CONNECTION:-}" ]] && command -v host-label > /dev/null && RPROMPT="%F{magenta}[$(host-label)]%f"
fi

# 8. Sourcing Local Files & Secrets (if present)
if [[ -f "$HOME/.aliases" ]]; then
    source "$HOME/.aliases"
fi

if [[ -f "$HOME/.zshrc.local" ]]; then
    source "$HOME/.zshrc.local"
fi

# Work-specific env files are sourced from ~/.zshrc.local, not listed here.
env_files=(
    "$HOME/secrets.env"
)
for env_file in "${env_files[@]}"; do
    if [[ -r "$env_file" ]]; then
        source "$env_file"
    fi
done
{{- if eq .chezmoi.os "darwin" }}

# 9. macOS Userland: GNU or Apple command-line tools (`userland` shows the mode; cheatsheet §1)
#   gnu (default): aliases make ls, sed, grep, find, tar, awk, make and the rest of coreutils the GNU versions in this
#       interactive shell only. Scripts and other child processes keep Apple's tools, because macOS scripts that use
#       BSD flags (sed -i '', stat -f, date -v, base64 -D, mktemp -t, dd bs=1m) break under the GNU ones.
#   apple: Apple's tools; GNU only under the g prefix (gsed, gls).
#   gnu-path: the gnubin directories first on PATH, so child processes get GNU too (Linux-minded scripts).
# A host sets its default with MACOS_USERLAND in ~/.zshrc.local, which is why this runs last. The formula list is
# explicit because libtool also ships a gnubin, and GNU libtool in place of Apple's /usr/bin/libtool breaks Xcode builds.
zmodload zsh/parameter 2> /dev/null
typeset -ga _userland_aliased
typeset -gA _userland_saved
typeset -g _userland_mode="${_userland_mode:-apple}"
userland() {
    local mode="${1:-}" prefix="${HOMEBREW_PREFIX:-/opt/homebrew}" formula gnubin cmd value
    local -a gnubins
    for formula in coreutils findutils gawk gnu-sed gnu-tar grep make; do
        gnubin="$prefix/opt/$formula/libexec/gnubin"
        [[ -d "$gnubin" ]] && gnubins+=("$gnubin")
    done
    case "$mode" in
        "") print -r -- "userland: $_userland_mode (switch with: userland gnu|apple|gnu-path)"; return 0 ;;
        gnu | apple | gnu-path) ;;
        *) print -ru2 -- "usage: userland [gnu|apple|gnu-path]"; return 2 ;;
    esac
    # Undo the current mode: drop the aliases it added, restore the ones it rewrote, take gnubin off PATH.
    for cmd in $_userland_aliased; do unalias "$cmd" 2> /dev/null; done
    for cmd in ${(k)_userland_saved}; do aliases[$cmd]="${_userland_saved[$cmd]}"; done
    _userland_aliased=()
    _userland_saved=()
    path=(${path:|gnubins})
    if [[ "$mode" == gnu ]]; then
        for gnubin in $gnubins; do
            for cmd in "$gnubin"/*(N:t); do
                # Only commands macOS also has (the rest are on PATH unprefixed already), and never shell builtins.
                (( $+builtins[$cmd] )) && continue
                [[ -x /bin/$cmd || -x /usr/bin/$cmd || -x /sbin/$cmd || -x /usr/sbin/$cmd ]] || continue
                [[ -x "$prefix/bin/g$cmd" ]] || continue
                if (( $+aliases[$cmd] )); then
                    # zsh does not expand an alias's own name again, so mkdir="mkdir -p" would keep Apple's mkdir:
                    # point such aliases at the GNU tool, and leave aliases to other commands alone.
                    value="${aliases[$cmd]}"
                    [[ "$value" == "$cmd" || "$value" == "$cmd "* ]] || continue
                    _userland_saved[$cmd]="$value"
                    aliases[$cmd]="g$cmd${value#$cmd}"
                else
                    aliases[$cmd]="g$cmd"
                    _userland_aliased+=("$cmd")
                fi
            done
        done
    elif [[ "$mode" == gnu-path ]]; then
        path=($gnubins $path)
    fi
    _userland_mode="$mode"
}
# Interactive shells only. Claude Code sources this file in a non-interactive shell (`zsh -c -l`) and replays its
# aliases into every command it runs, where gdate in place of date broke `date -v`.
if [[ -o interactive ]]; then
    userland "${MACOS_USERLAND:-gnu}"
fi

# 9b. iTerm2 shell integration, in iTerm2 only (also inside tmux there): prompt marks (Cmd+Shift+Up/Down), select or
# copy one command's output, command status and duration, alerts when a long command ends, recent directories, and
# iTerm2's utilities on PATH (imgcat, it2dl, it2ul, it2copy, cc-status, ...). Loaded from the app itself, so it
# updates with iTerm2. Wave, Warp, Terminal and SSH sessions are left alone.
_iterm2_resources=/Applications/iTerm.app/Contents/Resources
if [[ -o interactive && ( "${TERM_PROGRAM:-}" == iTerm.app || "${LC_TERMINAL:-}" == iTerm2 ) && -z "${SSH_CONNECTION:-}" \
    && -r "$_iterm2_resources/iterm2_shell_integration.zsh" ]]; then
    source "$_iterm2_resources/iterm2_shell_integration.zsh"
    [[ -d "$_iterm2_resources/utilities" ]] && path+=("$_iterm2_resources/utilities")
fi
unset _iterm2_resources
{{- end }}

# 9a. Syntax highlighting as you type (zsh-syntax-highlighting). Last, after ~/.zshrc.local, so it sees every widget
# defined before it. Skipped where it is already loaded (Omarchy's zsh options load it).
if [[ -o interactive && -z "${ZSH_HIGHLIGHT_VERSION:-}" ]]; then
    for _plugin in \
        "${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" \
        /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
        /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh; do
        if [[ -r "$_plugin" ]]; then
            source "$_plugin"
            break
        fi
    done
    unset _plugin
fi

# 10. Aliases are for interactive shells. Claude Code sources this file in a non-interactive shell and replays every
# alias into each command it runs, where an alias also blocks a function of the same name (`g() { ...; }` fails to
# parse). Dropping them here also covers those defined by ~/.zshrc.local and the env files it sources. `config` still
# works without its alias, as ~/.local/bin/config.
if [[ ! -o interactive ]]; then
    unalias -a
fi
