{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
# macOS only. Let programs in iTerm2 put text on the Mac clipboard (OSC 52), as foot does on Omarchy: copies in tmux,
# herdr and Neovim, also on a remote host over SSH, then land on the clipboard. Programs can set the clipboard this
# way, not read it. iTerm2 keeps this as a global setting ("Applications in terminal may access clipboard"), not in a
# profile, so the dynamic profile cannot carry it. Then reports two once-per-Mac steps chezmoi cannot do: chezmoi's
# profile as the default, and iTerm2's Claude Code integration. Each step not done goes on the list printed at the end
# of the apply. Informational: never fails the apply.
set -u
[[ -d /Applications/iTerm.app ]] || exit 0
{{ template "after-apply.sh" . }}
if [[ "$(defaults read com.googlecode.iterm2 AllowClipboardAccess 2> /dev/null)" == 1 ]]; then
    echo "OK:   iTerm2 lets terminal programs set the clipboard"
elif ! defaults write com.googlecode.iterm2 AllowClipboardAccess -bool true; then
    echo "NOTE: could not set iTerm2's clipboard setting; tick Settings > General > Selection > Applications in terminal may access clipboard"
    todo "Tick iTerm2's Settings > General > Selection > Applications in terminal may access clipboard"
elif pgrep -xq iTerm2; then
    echo "NOTE: iTerm2 may now let terminal programs set the clipboard; quit and reopen iTerm2 for it to take effect (or tick Settings > General > Selection > Applications in terminal may access clipboard)"
    todo "Quit and reopen iTerm2, so programs in it can set the clipboard"
else
    echo "OK:   iTerm2 now lets terminal programs set the clipboard"
fi

# Once per Mac, by hand (cheatsheet: "Option as Alt in the Mac Terminals", "iTerm2 Shell Integration and Claude Code").
if [[ "$(defaults read com.googlecode.iterm2 "Default Bookmark Guid" 2> /dev/null)" == chezmoi-left-option-as-alt ]]; then
    echo "OK:   iTerm2's default profile is chezmoi's (left Option as Alt)"
else
    echo "NOTE: iTerm2's default profile is not chezmoi's, so new tabs lack left Option as Alt and the Claude Code triggers"
    todo "Make chezmoi's iTerm2 profile the default: Settings > Profiles, select \"Default (Left Option as Alt)\", Other Actions > Set as Default"
fi
if [[ -x "$HOME/.config/iterm2/it2" ]] && grep -q 'handle-agent-hook' "$HOME/.claude/settings.json" 2> /dev/null; then
    echo "OK:   iTerm2's Claude Code integration is installed"
else
    echo "NOTE: iTerm2's Claude Code integration is missing (its it2 helper or its hook in ~/.claude/settings.json)"
    todo "Install iTerm2's Claude Code integration: menu iTerm2 > Install Claude Code Integration, then Mark Rewritable and Install"
fi
exit 0
{{ end -}}
