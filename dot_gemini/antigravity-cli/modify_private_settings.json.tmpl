#!/usr/bin/env bash
# chezmoi modify script for Antigravity's CLI (agy) ~/.gemini/antigravity-cli/settings.json: agy writes this file itself
# (trusted workspaces and the rest of /settings), so only the usability keys are set and everything else is passed
# through. The values come from [agent_usability] in .chezmoidata/agents.toml, but unlike the other agents a false does
# not write an opposite value: agy rejects any editorMode but "vim" (a blocking "Settings Error ... unrecognized value"
# dialog at start, tested with "normal"), so editorMode is "vim" on and the key removed off (its default), and agy drops
# copyOnSelect true (its default) at every start but keeps false, so copyOnSelect is removed on and false off. That is
# what agy writes itself, so nothing churns. Antigravity has no mouse setting: its full-screen mode always takes the
# mouse. Only this folder (and ~/.gemini as its parent) is managed: ai-tooling owns the rest of ~/.gemini (AGENTS.md,
# skills). Runs under bash 3.2, the macOS /bin/bash. Cheatsheet: "Same Keys in Every Agent".
set -euo pipefail
# shellcheck disable=SC2016 # jq variables, not shell ones
filter='(if $vim then .editorMode = "vim" else del(.editorMode) end) | (if $copy then del(.copyOnSelect) else .copyOnSelect = false end)'
args=(--argjson vim {{ .agent_usability.vim_keys }} --argjson copy {{ .agent_usability.copy_on_select }})
{{ template "modify-json.sh" . }}
