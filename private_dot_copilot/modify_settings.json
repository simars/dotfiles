#!/usr/bin/env bash
# chezmoi modify script for GitHub Copilot CLI's ~/.copilot/settings.json: Copilot writes this file itself (plugins,
# hooks, `copilot config`), so only one setting is set here and everything else is passed through. Selecting text with
# the mouse copies it, as in every terminal, tmux and Herdr here: Copilot's copyOnSelect is on by default only on
# macOS, so on Linux its mouse selection (which it takes over from the terminal and Herdr) copied nothing until Ctrl+C.
# Copilot reads the file at start. Runs under bash 3.2, the macOS /bin/bash.
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
current="$(cat)"
[[ -n "${current//[[:space:]]/}" ]] || current='{}'
if command -v jq > /dev/null 2>&1 && updated="$(printf '%s\n' "$current" | jq --indent 2 '.copyOnSelect = true' 2> /dev/null)"; then
    printf '%s\n' "$updated"
else
    # No jq, or not JSON: leave the file exactly as it is.
    printf '%s' "$current"
fi
