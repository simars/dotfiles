-- Window keys: Omarchy's window keys on the Mac, with one prefix for both (cheatsheet: "Window Keys").
--   Ctrl+Option+Cmd + arrows          focus the nearest window in that direction (across screens too)
--   Ctrl+Option+Cmd + Shift + arrows  swap the focused window with that one (they trade frames)
--   Ctrl+Option+Cmd + 1-9             show desktop N of the screen under the mouse
--   Ctrl+Option+Cmd + Shift + 1-9     send the focused window to desktop N of its screen, and go with it
--   Ctrl+Option+Cmd + L               lay out this screen's windows once, like Hyprland's dwindle layout
--   Ctrl+Option+Cmd + U               the window rescue (as Cmd+Ctrl+U)
-- Holding Caps Lock does the same as holding Ctrl+Option+Cmd; a tap of Caps Lock still toggles capitals. macOS hands
-- Caps Lock over as F18 (hidutil, .chezmoidata/macos.toml caps_lock_remap), which M.capsKey turns into these actions.
-- On Omarchy the same prefix is Ctrl+Alt+Super (private guide ~/guides/omarchy/window-keys). Keys act only when
-- pressed: nothing re-tiles by itself, so Swish's gestures keep working as before.
--
-- Desktops: macOS numbers them across screens, in Mission Control's display order (the main display first), and
-- Hammerspoon can neither switch desktops (hs.spaces.gotoSpace fails on macOS 27) nor move a window to another one
-- (moveWindowToSpace, closed in macOS 14.5). So chezmoi's macOS settings script binds macOS's own "Switch to Desktop
-- 1-16" to a hidden combination (.chezmoidata/macos.toml, desktop_shortcuts), and these keys press it. To send a
-- window, it is held by its title bar while macOS switches: macOS carries a held window along.
-- `open -g "hammerspoon://window-keys-probe"` logs which spots at the top of the focused window drag it, for an app
-- whose windows will not send (add its spot to GRAB). Sends, tiles, refused keys and probes are logged to
-- ~/Library/Logs/window-keys.log.

local M = {}

local PREFIX = { "cmd", "ctrl", "alt" }
local PREFIX_SHIFT = { "cmd", "ctrl", "alt", "shift" }
local LOG = os.getenv("HOME") .. "/Library/Logs/window-keys.log"
local GAP = 8 -- px between tiled windows

-- macOS's hidden "Switch to Desktop N" shortcuts, Desktop 1 first (from .chezmoidata/macos.toml): key codes, the
-- same ones the macOS settings script writes, so the keyboard layout cannot change them.
M.HIDDEN = {
  mods = { {{ range $i, $m := .desktop_shortcuts.hs_modifiers }}{{ if $i }}, {{ end }}{{ $m | quote }}{{ end }} },
  keys = { {{ range $i, $k := .desktop_shortcuts.keys }}{{ if $i }}, {{ end }}{{ $k.code }}{{ end }} },
}
M.timers = {} -- running timers, kept so they are not garbage-collected mid-way

local DIRS = { left = "West", right = "East", up = "North", down = "South" }

-- Apps that draw their own top bar: an empty spot there that drags the window (found with the probe).
local GRAB = {
  ["com.google.Chrome"] = function(f) return { x = f.x + f.w - 140, y = f.y + 6 } end, -- end of the tab strip
  ["com.tinyspeck.slackmacgap"] = function(f) return { x = f.x + math.min(260, f.w * 0.22), y = f.y + 14 } end,
}

local function log(line)
  local file = io.open(LOG, "a")
  if file then
    file:write(os.date("%Y-%m-%d %H:%M:%S ") .. line .. "\n")
    file:close()
  end
end

local function refuse(message)
  hs.alert.show(message)
  log("refused: " .. message)
end

-- Desktop n of a screen as macOS's global Desktop number. displays: hs.spaces.data_managedDisplaySpaces().
-- Returns the global number (nil when the screen has fewer than n desktops or the number has no shortcut), the
-- screen's desktop count, and the desktop's space id.
function M.globalDesktop(displays, screenUUID, isPrimary, n)
  local before = 0
  for _, display in ipairs(displays or {}) do
    local id = display["Display Identifier"]
    local desks = {}
    for _, space in ipairs(display.Spaces or {}) do
      if space.type == 0 then desks[#desks + 1] = space.ManagedSpaceID end
    end
    if id == screenUUID or (id == "Main" and isPrimary) then
      if n > #desks or before + n > #M.HIDDEN.keys then return nil, #desks, nil end
      return before + n, #desks, desks[n]
    end
    before = before + #desks
  end
  return nil, 0, nil
end

local function desktopOf(screen, n)
  return M.globalDesktop(hs.spaces.data_managedDisplaySpaces(), screen:getUUID(), screen == hs.screen.primaryScreen(), n)
end

local function refuseDesktop(screen, n, count)
  if n > count then
    refuse(string.format("Only %d desktop%s on %s", count, count == 1 and "" or "s", screen:name()))
  else
    refuse("Desktop " .. n .. " on " .. screen:name() .. " is beyond macOS's 16 desktop shortcuts")
  end
end

-- Key events this module posts carry this tag, so the Caps Lock layer lets them through.
local OWN_EVENT = 0x57494E4B

local function pressDesktop(g)
  local event = hs.eventtap.event
  local code = M.HIDDEN.keys[g]
  event.newKeyEvent(M.HIDDEN.mods, code, true):setProperty(event.properties.eventSourceUserData, OWN_EVENT):post()
  event.newKeyEvent(M.HIDDEN.mods, code, false):setProperty(event.properties.eventSourceUserData, OWN_EVENT):post()
end

local function modifiersHeld()
  local m = hs.eventtap.checkKeyboardModifiers()
  return m.cmd or m.ctrl or m.alt or m.shift or m.fn
end

-- Run whenReleased once the keys are let go (macOS would otherwise see the held prefix together with the hidden
-- shortcut, and a held Ctrl turns a click into a right-click); after 2 s still held, run whenStillHeld instead.
local function afterRelease(whenReleased, whenStillHeld)
  local started = hs.timer.secondsSinceEpoch()
  M.timers.wait = hs.timer.waitUntil(function()
    return not modifiersHeld() or hs.timer.secondsSinceEpoch() - started > 2
  end, function()
    if modifiersHeld() then whenStillHeld() else whenReleased() end
  end, 0.02)
end

local function focusDir(dir)
  local win = hs.window.focusedWindow()
  if win then win["focusWindow" .. DIRS[dir]](win, nil, true, true) end
end

local function swapDir(dir)
  local win = hs.window.focusedWindow()
  if not win then return end
  local other = (win["windowsTo" .. DIRS[dir]](win, nil, true, true) or {})[1]
  if not other then return end
  local a, b = win:frame(), other:frame()
  win:setFrame(b, 0)
  other:setFrame(a, 0)
  win:focus()
end

-- Pressed at once: the prefix is usually still held, to tap the next digit (as on Omarchy). A press macOS ignored is
-- logged.
function M.go(n)
  local screen = hs.mouse.getCurrentScreen() or hs.screen.mainScreen()
  local g, count, space = desktopOf(screen, n)
  if not g then return refuseDesktop(screen, n, count) end
  pressDesktop(g)
  M.timers.go = hs.timer.doAfter(1.5, function() -- after macOS's slide to the desktop
    if (hs.spaces.activeSpaces() or {})[screen:getUUID()] ~= space then
      log(string.format("go to desktop %d (macOS Desktop %d) on %s: did NOT switch", n, g, tostring(screen:name())))
    end
  end)
end

local function grabPoint(win)
  local f = win:frame()
  local app = win:application()
  local bundle = app and app:bundleID() or "?"
  if GRAB[bundle] then return GRAB[bundle](f), bundle end
  local zoom = win:zoomButtonRect()
  if zoom then return { x = zoom.x + zoom.w + 6, y = zoom.y + zoom.h / 2 }, bundle end
  return { x = f.x + 80, y = f.y + 12 }, bundle
end

-- Controls a click would operate: never grabbed (the probe skips them too).
local SKIP = { AXButton = true, AXRadioButton = true, AXTextField = true, AXSearchField = true, AXLink = true,
  AXMenuButton = true, AXPopUpButton = true, AXCheckBox = true, AXTab = true, AXTextArea = true, AXComboBox = true }
local function roleAt(p)
  local el = hs.axuielement.systemElementAtPosition(p.x, p.y)
  return el and el:attributeValue("AXRole") or "?"
end

-- Once the keys are released, hold the window by an empty spot of its title bar, press macOS's desktop shortcut,
-- let go after 0.5 s, and put the mouse back. The mouse button always comes back up, even if the key press fails.
function M.send(n)
  local win = hs.window.focusedWindow()
  if not win then return end
  local screen = win:screen()
  local g, count, space = desktopOf(screen, n)
  if not g then return refuseDesktop(screen, n, count) end
  afterRelease(function()
    local point, bundle = grabPoint(win)
    if SKIP[roleAt(point)] then
      return refuse("No empty title-bar spot to hold this window by (hammerspoon://window-keys-probe)")
    end
    local home = hs.mouse.absolutePosition()
    local event = hs.eventtap.event
    local nudged = { x = point.x + 1, y = point.y }
    local function letGo()
      event.newMouseEvent(event.types.leftMouseUp, nudged, {}):post()
      hs.mouse.absolutePosition(home)
    end
    hs.mouse.absolutePosition(point)
    event.newMouseEvent(event.types.leftMouseDown, point, {}):post()
    hs.timer.usleep(60000)
    event.newMouseEvent(event.types.leftMouseDragged, nudged, {}):post()
    hs.timer.usleep(60000)
    if not pcall(pressDesktop, g) then
      letGo()
      return refuse("Could not press macOS's desktop shortcut")
    end
    M.timers.hold = hs.timer.doAfter(0.5, function()
      letGo()
      M.timers.check = hs.timer.doAfter(0.3, function()
        local now = hs.spaces.windowSpaces(win) or {}
        log(string.format("send to desktop %d (macOS Desktop %d) [%s] %s: %s", n, g, bundle, win:title(),
          now[1] == space and "moved" or "NOT moved (add a GRAB spot: hammerspoon://window-keys-probe)"))
      end)
    end)
  end, function() refuse("Let go of the keys to send the window") end)
end

-- Dwindle, like Hyprland: each window, most recently used first, takes half of the space left, splitting left/right
-- and top/bottom in turn (left/right first on a screen wider than tall).
local function tile()
  local focused = hs.window.focusedWindow()
  local screen = focused and focused:screen() or hs.mouse.getCurrentScreen() or hs.screen.mainScreen()
  local wins = hs.fnutils.filter(hs.window.orderedWindows(), function(win)
    return win:isStandard() and win:isVisible() and win:screen() == screen
  end)
  local rest = screen:frame():copy()
  local wideFirst = rest.w >= rest.h
  for i, win in ipairs(wins) do
    local f = rest:copy()
    if i < #wins then
      if (i % 2 == 1) == wideFirst then
        f.w = rest.w / 2
        rest.x, rest.w = rest.x + f.w, rest.w - f.w
      else
        f.h = rest.h / 2
        rest.y, rest.h = rest.y + f.h, rest.h - f.h
      end
    end
    win:setFrame({ x = f.x + GAP / 2, y = f.y + GAP / 2, w = f.w - GAP, h = f.h - GAP }, 0)
  end
  log("tile: " .. #wins .. " windows on " .. screen:name())
end

-- Which spots at the top of the focused window drag it? Controls (SKIP) are left alone; each other spot is dragged
-- 12 px right and the frame put back.
local function probe()
  local win = hs.window.focusedWindow()
  if not win then return end
  local app = win:application()
  local bundle = app and app:bundleID() or "?"
  local f0 = win:frame()
  local home = hs.mouse.absolutePosition()
  local event = hs.eventtap.event
  local hits = {}
  for _, dy in ipairs({ 3, 6, 10, 16, 24, 34 }) do
    for _, fx in ipairs({ 90 / f0.w, 0.15, 0.3, 0.5, 0.7, (f0.w - 140) / f0.w, (f0.w - 60) / f0.w }) do
      local p = { x = math.floor(f0.x + fx * f0.w), y = f0.y + dy }
      if not SKIP[roleAt(p)] then
        hs.mouse.absolutePosition(p)
        event.newMouseEvent(event.types.leftMouseDown, p, {}):post()
        hs.timer.usleep(80000)
        for step = 1, 4 do
          event.newMouseEvent(event.types.leftMouseDragged, { x = p.x + 3 * step, y = p.y }, {}):post()
          hs.timer.usleep(30000)
        end
        event.newMouseEvent(event.types.leftMouseUp, { x = p.x + 12, y = p.y }, {}):post()
        hs.timer.usleep(150000)
        if math.abs(win:frame().x - f0.x) >= 6 then
          hits[#hits + 1] = string.format("(+%d,+%d)", p.x - f0.x, dy)
          win:setFrame(f0, 0)
        end
      end
    end
  end
  hs.mouse.absolutePosition(home)
  win:focus()
  log("probe [" .. bundle .. "] drags at " .. (#hits > 0 and table.concat(hits, " ") or "no spot"))
  hs.alert.show("Probe: " .. (#hits > 0 and #hits .. " spots drag " .. bundle or "no spot drags " .. bundle))
end

-- Caps Lock (arriving as F18) as a one-key prefix. kind "down" or "up"; key an hs.keycodes.map name; shift and
-- isRepeat booleans; now in seconds. Returns the action to run (or nil) and whether to swallow the event.
--   tap (F18 down and up, nothing between)          toggles Caps Lock
--   F18 held + a window key                          that key's action; held arrows repeat, the rest act once
--   F18 held + any other key                         swallowed (prefix + an unbound key does nothing)...
--   ... unless it comes within 200 ms of F18 and first: typing fast from Caps onto a letter is a Caps tap and the
--       letter is typed (as keyd's overloadt2 on Omarchy)
--   a key swallowed while F18 was held               its repeats and release are swallowed too, even after F18 is up;
--                                                    any other key-up passes (a key pressed before Caps comes up)
--   no F18 or layer event for 3 s                    the hold is stale (a missed release): keys pass again
local LAYER = { left = "left", right = "right", up = "up", down = "down" }
local ROLL, STALE = 0.2, 3
local caps = { held = false, used = false, since = 0, last = 0, swallowed = {} }
function M.capsKey(kind, key, shift, isRepeat, now)
  now = now or 0
  if key == "f18" then
    if kind == "down" then
      if not isRepeat then caps.held, caps.used, caps.since = true, false, now end
      if caps.held then caps.last = now end
      return nil, true
    end
    local tap = caps.held and not caps.used
    caps.held = false
    return tap and "toggle-caps" or nil, true
  end
  if kind ~= "down" then
    if caps.swallowed[key] then caps.swallowed[key] = nil return nil, true end
    return nil, false
  end
  if not caps.held then return nil, caps.swallowed[key] == true end
  if now - caps.last > STALE then caps.held = false return nil, false end
  caps.last = now
  local action
  if LAYER[key] then action = (shift and "swap " or "focus ") .. key
  elseif key:match("^[1-9]$") then action = (shift and "send " or "go ") .. key
  elseif key == "l" then action = "tile"
  elseif key == "u" then action = "rescue"
  end
  if not action and not caps.used and now - caps.since < ROLL then
    caps.held = false
    return "toggle-caps", false
  end
  caps.used = true
  caps.swallowed[key] = true
  if action and isRepeat and not LAYER[key] then action = nil end
  return action, true
end
function M.capsReset() caps.held, caps.swallowed = false, {} end

local function runCapsAction(action)
  local verb, arg = action:match("^(%S+) ?(.*)$")
  if verb == "toggle-caps" then hs.hid.capslock.toggle()
  elseif verb == "focus" then focusDir(arg)
  elseif verb == "swap" then swapDir(arg)
  elseif verb == "go" then M.go(tonumber(arg))
  elseif verb == "send" then M.send(tonumber(arg))
  elseif verb == "tile" then tile()
  elseif verb == "rescue" then require("window_rescue").rescue(false)
  end
end

-- Hammerspoon owns the Caps Lock to F18 remap (macOS's hidutil): set while it runs, cleared when it quits, so Caps Lock
-- is plain Caps Lock whenever Hammerspoon is not there to read F18. Set again when a USB device is connected, after a
-- wake and at unlock, so a keyboard that appears later gets it too (setting it again is harmless).
local REMAP = '{"UserKeyMapping":[{"HIDKeyboardModifierMappingSrc":{{ .caps_lock_remap.src }},"HIDKeyboardModifierMappingDst":{{ .caps_lock_remap.dst }}}]}'
local function hidutil(mapping) return hs.task.new("/usr/bin/hidutil", nil, { "property", "--set", mapping }):start() end
function M.ownRemap()
  hidutil(REMAP)
  M.usbWatch = hs.usb.watcher.new(function(device) if device.eventType == "added" then hidutil(REMAP) end end):start()
  local cw = hs.caffeinate.watcher
  M.powerWatch = cw.new(function(e) if e == cw.systemDidWake or e == cw.screensDidUnlock then hidutil(REMAP) end end):start()
  local previous = hs.shutdownCallback
  hs.shutdownCallback = function()
    hidutil('{"UserKeyMapping":[]}'):waitUntilExit() -- also on a config reload; the reload sets it again at start
    if previous then previous() end
  end
end

local function startCapsLayer()
  local types, props = hs.eventtap.event.types, hs.eventtap.event.properties
  M.capsTap = hs.eventtap.new({ types.keyDown, types.keyUp }, function(e)
    -- Any error lets the event through: a broken layer must never eat the keyboard.
    local ok, action, consume = pcall(function()
      if e:getProperty(props.eventSourceUserData) == OWN_EVENT then return nil, false end
      return M.capsKey(e:getType() == types.keyDown and "down" or "up", hs.keycodes.map[e:getKeyCode()] or "?",
        e:getFlags().shift == true, e:getProperty(props.keyboardEventAutorepeat) == 1, hs.timer.secondsSinceEpoch())
    end)
    if not ok then return false end
    if action then M.timers.caps = hs.timer.doAfter(0, function() runCapsAction(action) end) end
    return consume
  end):start()
  -- macOS turns an event tap off when a callback is slow, and the Caps release may be lost then: forget the hold.
  M.capsWatch = hs.timer.doEvery(5, function()
    if not M.capsTap:isEnabled() then M.capsReset() M.capsTap:start() end
  end)
end

function M.start()
  M.hotkeys = {}
  local function bind(mods, key, fn) M.hotkeys[#M.hotkeys + 1] = hs.hotkey.bind(mods, key, fn) end
  for dir in pairs(DIRS) do
    bind(PREFIX, dir, function() focusDir(dir) end)
    bind(PREFIX_SHIFT, dir, function() swapDir(dir) end)
  end
  for n = 1, 9 do
    bind(PREFIX, tostring(n), function() M.go(n) end)
    bind(PREFIX_SHIFT, tostring(n), function() M.send(n) end)
  end
  bind(PREFIX, "l", tile)
  bind(PREFIX, "u", function() require("window_rescue").rescue(false) end)
  hs.urlevent.bind("window-keys-probe", probe)
  startCapsLayer()
  M.ownRemap()
end

return M
