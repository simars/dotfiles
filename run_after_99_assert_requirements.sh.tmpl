#!/usr/bin/env bash
# Report after every apply whether the global git hooks in ~/.gitconfig protect commits on this machine: git must be
# >= {{ .requirements.git.min }} for hooks defined in config to run at all, and gitleaks must be installed for the
# secret scan. A missing gitleaks fails the run; everything else only warns.
set -uo pipefail

if [[ "${CHEZMOI_CI:-false}" == "true" ]]; then
    echo "==> CI environment detected: skipping requirement assertions."
    exit 0
fi

export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
GIT_MIN="{{ .requirements.git.min }}"
failed=0
warned=0

# version_ge A B: succeed when version A >= version B
version_ge() {
    [[ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n 1)" == "$2" ]]
}

# report LEVEL MESSAGE: LEVEL "fail" fails the run, "warn" only prints a warning
report() {
    if [[ "$1" == "warn" ]]; then
        echo "WARN: $2"
        warned=1
    else
        echo "FAIL: $2"
        failed=1
    fi
}

{{ if and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "arm64") -}}
fix_git="brew install git"
fix_gitleaks="brew install gitleaks"
{{- else if eq .chezmoi.os "darwin" -}}
fix_git="Intel Homebrew has no git bottle; build git into ~/.local as docs/INTEL_MACS.md in the chezmoi source describes"
fix_gitleaks="docs/INTEL_MACS.md in the chezmoi source"
{{- else if eq (dig "osRelease" "id" "" .chezmoi) "omarchy" -}}
{{- /* Omarchy installs packages through its own command, never pacman directly. */}}
fix_git="omarchy pkg add git"
fix_gitleaks="omarchy pkg add gitleaks"
{{- else -}}
fix_git="install it with the system package manager (Arch: sudo pacman -S git)"
fix_gitleaks="install it with the system package manager (Arch: sudo pacman -S gitleaks)"
{{- end }}

git_v="$(git --version 2> /dev/null | awk '{print $3}' | sed 's/[^0-9.].*//')"
if [[ -n "$git_v" ]] && version_ge "$git_v" "$GIT_MIN"; then
    echo "OK:   git $git_v ($(command -v git))"
else
    report warn "git ${git_v:-is not installed} ($(command -v git || echo none)) is older than $GIT_MIN, so the global hooks in ~/.gitconfig (gitleaks, identity guard) do not run on this machine. Fix: $fix_git"
fi

if command -v gitleaks &> /dev/null; then
    echo "OK:   gitleaks $(gitleaks version 2> /dev/null) ($(command -v gitleaks))"
else
    report fail "gitleaks is not installed, so the pre-commit hook skips scanning. Fix: $fix_gitleaks"
fi

{{- if eq (dig "osRelease" "id" "" .chezmoi) "omarchy" }}
{{- $packages := index . "packages" | default . }}

# Omarchy: the packages listed in packages.toml. The install step runs only when packages.toml changes and installs
# only from a terminal, so keep reporting what is still missing. Warn only.
missing_packages() {
    local package
    for package in "$@"; do
        if omarchy pkg missing "$package"; then
            printf '%s ' "$package"
        fi
    done
}
need="$(missing_packages{{ range $packages.omarchy.pacman }} {{ . | quote }}{{ end }})"
[[ -z "$need" ]] || report warn "packages.toml lists packages that are not installed. Fix: omarchy pkg add ${need% }"
need="$(missing_packages{{ range $packages.omarchy.aur }} {{ . | quote }}{{ end }})"
[[ -z "$need" ]] || report warn "packages.toml lists AUR packages that are not installed. Fix: omarchy pkg aur add ${need% }"
{{- end }}

# mise: warn only. An old mise or an uninstalled project pin is not a secret-scanning gap, and a stale pin
# in some side repo must not fail the apply.
MISE_MIN="{{ .requirements.mise.min }}"
if command -v mise &> /dev/null; then
    mise_bin="$(command -v mise)"
    mise_v="$(mise --version 2> /dev/null | awk '{print $1}')"
{{- if eq (dig "osRelease" "id" "" .chezmoi) "omarchy" }}
    # Omarchy installs and configures mise itself, and this repository leaves its ~/.config/mise alone.
    echo "OK:   mise ${mise_v:-of unknown version} ($mise_bin) is Omarchy's; its version is not checked here"
{{- if .omarchy_mise_project_settings }}
    # Option B: ~/.config/mise/conf.d/50-shared.toml asks mise to follow .python-version and .ruby-version. The same
    # setting in ~/.config/mise/config.toml (or a newer Omarchy file) replaces ours instead of merging with it;
    # `omarchy install dev-env ruby` writes ["ruby"] there, which silently drops python. Read from / so that no
    # project config takes part.
    # Compared as a set: `mise settings add` appends, so ["ruby", "python"] is as good. "node" is a finding too.
    want_idiomatic='["python", "ruby"]'
    have_idiomatic="$(cd / && mise settings get idiomatic_version_file_enable_tools 2> /dev/null)"
    if [[ "$(tr -d '[]" ' <<< "$have_idiomatic" | tr ',' '\n' | sort | xargs)" == "python ruby" ]]; then
        echo "OK:   mise follows .python-version and .ruby-version (option B)"
    else
        setters="$(grep -ls '^[[:space:]]*idiomatic_version_file_enable_tools' "$HOME/.config/mise/config.toml" /etc/mise/conf.d/*.toml 2> /dev/null | tr '\n' ' ')"
        report warn "mise's idiomatic_version_file_enable_tools is ${have_idiomatic:-unset}, not $want_idiomatic, so projects' version files are not all followed (set in: ${setters:-unknown}). Fix: mise settings add idiomatic_version_file_enable_tools python (and ruby), or remove the line from that file"
    fi
{{- end }}
{{- else }}
    case "$(readlink -f "$mise_bin" 2> /dev/null || echo "$mise_bin")" in
        */Cellar/*) mise_fix="brew upgrade mise" ;;
        *) mise_fix="mise self-update" ;;
    esac
    if [[ -n "$mise_v" ]] && version_ge "$mise_v" "$MISE_MIN"; then
        echo "OK:   mise $mise_v ($mise_bin)"
    else
        report warn "mise ${mise_v:-of unknown version} ($mise_bin) is older than $MISE_MIN, the release ~/.config/mise/config.toml was verified on. Fix: $mise_fix"
    fi
{{- end }}
    # A runtime ahead of mise's shims in a login shell wins in every project, pin or not. `uv python install`
    # puts such a python3 into ~/.local/bin, which ~/.zprofile places before the shims.
    shims="$HOME/.local/share/mise/shims"
    while IFS='=' read -r tool first; do
        [[ -e "$shims/$tool" && -n "$first" && "$first" != "$shims/$tool" ]] || continue
        report warn "$tool resolves to $first in a login shell, ahead of mise's shim, so projects get it instead of their pinned version. Fix: remove that link (for a uv Python, its versioned python3.X link can stay)"
    done < <(zsh -lc 'for t in python3 python ruby node go; do print -r -- "$t=$(whence -p $t)"; done' 2> /dev/null)
{{- if ne (dig "osRelease" "id" "" .chezmoi) "omarchy" }}
    {{- /* mise-audit is not deployed on Omarchy. */}}
    # The audit never installs anything; `mise-audit --install` does.
    if command -v mise-audit &> /dev/null; then
        if audit_out="$(mise-audit --quiet 2>&1)"; then
            echo "OK:   mise-audit: every project runtime pin under \$HOME is installed"
        else
            while IFS= read -r line; do echo "      $line"; done <<< "$audit_out"
            report warn "the project runtime pins above are not installed (a pin that cannot install stays listed until its project changes it). Fix: mise-audit --install"
        fi
    fi
{{- end }}
fi

if [[ "$failed" -ne 0 ]]; then
    echo "==> Requirement check failed: commits on this machine are not fully secret-scanned."
    exit 1
fi

if [[ "$warned" -ne 0 ]]; then
    echo "==> Requirement check passed with warnings (WARN lines above)."
fi
