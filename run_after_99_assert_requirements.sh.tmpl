#!/usr/bin/env bash
# Assert minimum tool versions after every apply. A failure here means the global
# gitleaks pre-commit hook is not protecting commits on this machine. The mise checks
# at the end only warn.
set -uo pipefail

if [[ "${CHEZMOI_CI:-false}" == "true" ]]; then
    echo "==> CI environment detected: skipping requirement assertions."
    exit 0
fi

export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
GIT_MIN="{{ .requirements.git.min }}"
failed=0
warned=0

# version_ge A B: succeed when version A >= version B
version_ge() {
    [[ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n 1)" == "$2" ]]
}

git_version() {
    "$1" --version 2> /dev/null | awk '{print $3}' | sed 's/[^0-9.].*//'
}

# report LEVEL MESSAGE: LEVEL "fail" fails the run, "warn" only prints a warning
report() {
    if [[ "$1" == "warn" ]]; then
        echo "WARN: $2"
        warned=1
    else
        echo "FAIL: $2"
        failed=1
    fi
}

# check_git BIN ROLE FIX [LEVEL]: LEVEL defaults to "fail"
check_git() {
    local bin="$1" role="$2" fix="$3" level="${4:-fail}" v
    v="$(git_version "$bin")"
    if [[ -z "$v" ]]; then
        report "$level" "$role ($bin) does not run. Fix: $fix"
    elif ! version_ge "$v" "$GIT_MIN"; then
        report "$level" "$role is git $v ($bin); the gitleaks hook needs >= $GIT_MIN. Fix: $fix"
    else
        echo "OK:   $role is git $v ($bin)"
    fi
}

{{ if eq .chezmoi.os "darwin" -}}
# Terminal git: whichever git leads PATH in a login shell
{{ if eq .chezmoi.arch "arm64" -}}
check_git "$(command -v git)" "terminal git" "brew install git"
{{- else -}}
check_git "$(command -v git)" "terminal git" "re-run chezmoi apply to build the standalone git into ~/.local/bin (it needs the Command Line Tools: xcode-select --install); Intel Homebrew has no git bottle and Xcode 27 is Apple silicon only"
{{- end }}

# Apple git: GUI apps launched from the Dock use /usr/bin/git, which follows xcode-select
{{ if eq .chezmoi.arch "arm64" -}}
APPLE_LEVEL="fail"
APPLE_FIX="sudo xcode-select -s /Applications/Xcode.app/Contents/Developer (Xcode 27.1+), or install Command Line Tools for Xcode 27.1+ (softwareupdate --list)"
{{- else -}}
# Intel Macs cannot get git >= {{ .requirements.git.min }} from Apple tooling (Xcode 27 is Apple silicon only), so this is a warning there.
APPLE_LEVEL="warn"
APPLE_FIX="none on Intel Macs: GUI apps that use /usr/bin/git skip the gitleaks hook; commit from a terminal, which uses the standalone git in ~/.local/bin"
{{- end }}
if ! xcode-select -p &> /dev/null; then
    report "$APPLE_LEVEL" "no Xcode or Command Line Tools selected, so /usr/bin/git cannot run. Fix: xcode-select --install"
else
    check_git /usr/bin/git "Apple /usr/bin/git ($(xcode-select -p))" "$APPLE_FIX" "$APPLE_LEVEL"
fi
{{- else }}
check_git "$(command -v git)" "git" "sudo add-apt-repository -y ppa:git-core/ppa && sudo apt-get install -y git"
{{- end }}

if command -v gitleaks &> /dev/null; then
    echo "OK:   gitleaks $(gitleaks version 2> /dev/null) ($(command -v gitleaks))"
else
{{- if eq .chezmoi.os "darwin" }}
    echo "FAIL: gitleaks is not installed, so the pre-commit hook skips scanning. Fix: brew install gitleaks"
{{- else }}
    echo "FAIL: gitleaks is not installed, so the pre-commit hook skips scanning. Fix: install the release binary from https://github.com/gitleaks/gitleaks/releases into /usr/local/bin"
{{- end }}
    failed=1
fi

# mise: warn only. An old mise or an uninstalled project pin is not a secret-scanning gap, and a stale pin
# in some side repo must not fail the apply. The audit never installs anything; `mise-audit --install` does.
MISE_MIN="{{ .requirements.mise.min }}"
if command -v mise &> /dev/null; then
    mise_bin="$(command -v mise)"
    mise_v="$(mise --version 2> /dev/null | awk '{print $1}')"
    case "$(readlink -f "$mise_bin" 2> /dev/null || echo "$mise_bin")" in
        */Cellar/*) mise_fix="brew upgrade mise" ;;
        *) mise_fix="mise self-update" ;;
    esac
    if [[ -n "$mise_v" ]] && version_ge "$mise_v" "$MISE_MIN"; then
        echo "OK:   mise $mise_v ($mise_bin)"
    else
        report warn "mise ${mise_v:-of unknown version} ($mise_bin) is older than $MISE_MIN, the release ~/.config/mise/config.toml was verified on. Fix: $mise_fix"
    fi
    if command -v mise-audit &> /dev/null; then
        if audit_out="$(mise-audit --quiet 2>&1)"; then
            echo "OK:   mise-audit: every project runtime pin under \$HOME is installed"
        else
            while IFS= read -r line; do echo "      $line"; done <<< "$audit_out"
            report warn "the project runtime pins above are not installed (a pin that cannot install stays listed until its project changes it). Fix: mise-audit --install"
        fi
    fi
fi

if [[ "$failed" -ne 0 ]]; then
    echo "==> Requirement check failed: commits on this machine are not fully secret-scanned."
    exit 1
fi

if [[ "$warned" -ne 0 ]]; then
    echo "==> Requirement check passed with warnings (WARN lines above)."
fi
