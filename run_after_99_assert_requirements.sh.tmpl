#!/usr/bin/env bash
# Report after every apply whether the global git hooks in ~/.gitconfig protect commits on this machine: git must be
# >= {{ .requirements.git.min }} for hooks defined in config to run at all, and gitleaks must be installed for the
# secret scan. A missing gitleaks fails the run; everything else only warns.
set -uo pipefail

if [[ "${CHEZMOI_CI:-false}" == "true" ]]; then
    echo "==> CI environment detected: skipping requirement assertions."
    exit 0
fi

export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
{{ template "after-apply.sh" . }}
GIT_MIN="{{ .requirements.git.min }}"
failed=0
warned=0

# version_ge A B: succeed when version A >= version B
version_ge() {
    [[ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n 1)" == "$2" ]]
}

# report LEVEL MESSAGE [off-list]: LEVEL "fail" fails the run, "warn" only prints a warning; both go on the to-do list
# unless the third argument is "off-list" (a warning that may never clear, so the list could never say "Nothing to do")
report() {
    [[ "${3:-}" == off-list ]] || todo "$2"
    if [[ "$1" == "warn" ]]; then
        echo "WARN: $2"
        warned=1
    else
        echo "FAIL: $2"
        failed=1
    fi
}

{{ if and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "arm64") -}}
fix_git="brew install git"
fix_gitleaks="brew install gitleaks"
{{- else if eq .chezmoi.os "darwin" -}}
fix_git="Intel Homebrew has no git bottle; build git into ~/.local as docs/INTEL_MACS.md in the chezmoi source describes"
fix_gitleaks="docs/INTEL_MACS.md in the chezmoi source"
{{- else if eq (dig "osRelease" "id" "" .chezmoi) "omarchy" -}}
{{- /* Omarchy installs packages through its own command, never pacman directly. */}}
fix_git="omarchy pkg add git"
fix_gitleaks="omarchy pkg add gitleaks"
{{- else -}}
fix_git="install it with the system package manager (Arch: sudo pacman -S git)"
fix_gitleaks="install it with the system package manager (Arch: sudo pacman -S gitleaks)"
{{- end }}

git_v="$(git --version 2> /dev/null | awk '{print $3}' | sed 's/[^0-9.].*//')"
if [[ -n "$git_v" ]] && version_ge "$git_v" "$GIT_MIN"; then
    echo "OK:   git $git_v ($(command -v git))"
else
    report warn "git ${git_v:-is not installed} ($(command -v git || echo none)) is older than $GIT_MIN, so the global hooks in ~/.gitconfig (gitleaks, identity guard) do not run on this machine. Fix: $fix_git"
fi

if command -v gitleaks &> /dev/null; then
    echo "OK:   gitleaks $(gitleaks version 2> /dev/null) ($(command -v gitleaks))"
else
    report fail "gitleaks is not installed, so the pre-commit hook skips scanning. Fix: $fix_gitleaks"
fi

# SSH key passphrase: warn only, never prompt. Saved once per machine with ssh-key-remember, the agent unlocks the key
# by itself after every login and reboot. "Cannot tell" (a Mac's Keychain is locked over SSH) is not a finding.
if [[ -f "$HOME/.ssh/id_rsa" ]] && command -v ssh-key-remember &> /dev/null; then
    ssh_key_out="$(ssh-key-remember --check 2>&1)"
    case $? in
        0) echo "OK:   ~/.ssh/id_rsa passphrase is saved (or it has none)" ;;
        1) report warn "the ~/.ssh/id_rsa passphrase is not saved, so the SSH agent asks for it after every reboot. Fix: ssh-key-remember (in a terminal on this machine)" ;;
        *) echo "NOTE: ~/.ssh/id_rsa passphrase not checked: ${ssh_key_out#ssh-key-remember: }" ;;
    esac
fi

{{- if eq (dig "osRelease" "id" "" .chezmoi) "omarchy" }}
{{- $packages := index . "packages" | default . }}

# Omarchy: the packages listed in packages.toml. The install step runs only when packages.toml changes and installs
# only from a terminal, so keep reporting what is still missing. Warn only.
missing_packages() {
    local package
    for package in "$@"; do
        if omarchy pkg missing "$package"; then
            printf '%s ' "$package"
        fi
    done
}
need="$(missing_packages{{ range $packages.omarchy.pacman }} {{ . | quote }}{{ end }})"
[[ -z "$need" ]] || report warn "packages.toml lists packages that are not installed. Fix: omarchy pkg add ${need% }"
need="$(missing_packages{{ range $packages.omarchy.aur }} {{ . | quote }}{{ end }})"
[[ -z "$need" ]] || report warn "packages.toml lists AUR packages that are not installed. Fix: omarchy pkg aur add ${need% }"

# Omarchy setup beyond packages (.chezmoidata/omarchy.toml): dev-env runtimes, shell plugins, guides. Warn only.
need=""
for lang in{{ range .omarchy_dev_env }} {{ . | quote }}{{ end }}; do
    mise ls --global "$lang" 2> /dev/null | grep -q . || need+="$lang "
done
if [[ -z "$need" ]]; then
    echo "OK:   Omarchy dev-env runtimes:{{ range .omarchy_dev_env }} {{ . }}{{ end }}"
else
    report warn "Omarchy dev-env runtimes missing: ${need% }. Fix: $(for l in $need; do printf 'omarchy install dev-env %s && ' "$l"; done | sed 's/ && $//')"
fi
{{- range .omarchy_installers }}
if omarchy pkg missing {{ .package | quote }}; then
    report warn "{{ .package }} is not installed. Fix: omarchy install {{ .command }}"
else
    echo "OK:   {{ .package }}"
fi
{{- end }}
plugins_json="$(omarchy plugin list --json 2> /dev/null)"
{{- range .omarchy_plugins }}
case "$(jq -r --arg id {{ .id | quote }} '.[] | select(.id == $id) | .enabled' <<< "$plugins_json" 2> /dev/null)" in
    true) echo "OK:   shell plugin {{ .id }}" ;;
    false) report warn "shell plugin {{ .id }} is installed but turned off. Fix: omarchy plugin enable {{ .id }} --section right" ;;
    *) report warn "shell plugin {{ .id }} is not installed. Fix: omarchy plugin add {{ .url }} --enable" ;;
esac
{{- end }}
if [[ -x "$HOME/.local/bin/setup-guides" ]]; then
    if guides_out="$("$HOME/.local/bin/setup-guides" 2>&1)"; then
        echo "OK:   Omarchy guides active:{{ range .omarchy_guides }} {{ . }}{{ end }}"
    else
        while IFS= read -r line; do echo "      $line"; done <<< "$guides_out"
        report warn "Omarchy guides above are not active. Fix: setup-guides apply"
    fi
fi
{{- end }}

{{- if ne (dig "osRelease" "id" "" .chezmoi) "omarchy" }}
{{- /* Omarchy: the packages.toml check above already covers zsh-autosuggestions, and Omarchy's zsh brings
       zsh-syntax-highlighting. */}}

# zsh plugins that ~/.zshrc loads when present: suggestions from history as you type, and syntax highlighting.
# Without them zsh works, but silently without either. Warn only.
{{- if and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "arm64") }}
fix_zsh_plugin="brew install @"
{{- else if eq .chezmoi.os "darwin" }}
fix_zsh_plugin="brew install @ if docs/INTEL_MACS.md (section 2's check) in the chezmoi source reports it as pour"
{{- else }}
fix_zsh_plugin="install @ with the system package manager (Arch: sudo pacman -S @; Debian and Ubuntu: sudo apt install @)"
{{- end }}
for zsh_plugin in zsh-autosuggestions zsh-syntax-highlighting; do
    found=""
    for dir in /opt/homebrew/share /usr/local/share /usr/share/zsh/plugins /usr/share; do
        if [[ -r "$dir/$zsh_plugin/$zsh_plugin.zsh" ]]; then
            found="$dir/$zsh_plugin"
            break
        fi
    done
    if [[ -n "$found" ]]; then
        echo "OK:   $zsh_plugin ($found)"
    elif [[ "$zsh_plugin" == zsh-autosuggestions && -r "$HOME/.oh-my-zsh/custom/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
        report warn "zsh-autosuggestions comes only from an old oh-my-zsh clone (~/.oh-my-zsh/custom/plugins). Fix: ${fix_zsh_plugin//@/$zsh_plugin}"
    else
        report warn "$zsh_plugin is not installed, so zsh runs without it. Fix: ${fix_zsh_plugin//@/$zsh_plugin}"
    fi
done
{{- end }}

# mise: warn only. An old mise or an uninstalled project pin is not a secret-scanning gap, and a stale pin
# in some side repo must not fail the apply.
MISE_MIN="{{ .requirements.mise.min }}"
if command -v mise &> /dev/null; then
    mise_bin="$(command -v mise)"
    mise_v="$(mise --version 2> /dev/null | awk '{print $1}')"
{{- if eq (dig "osRelease" "id" "" .chezmoi) "omarchy" }}
    # Omarchy installs and configures mise itself, and this repository leaves its ~/.config/mise alone.
    echo "OK:   mise ${mise_v:-of unknown version} ($mise_bin) is Omarchy's; its version is not checked here"
{{- if .omarchy_mise_project_settings }}
    # Option B: ~/.config/mise/conf.d/50-shared.toml asks mise to follow .python-version and .ruby-version. The same
    # setting in ~/.config/mise/config.toml (or a newer Omarchy file) replaces ours instead of merging with it;
    # `omarchy install dev-env ruby` writes ["ruby"] there, which silently drops python. Read from / so that no
    # project config takes part.
    # Compared as a set: `mise settings add` appends, so ["ruby", "python"] is as good. "node" is a finding too.
    want_idiomatic='["python", "ruby"]'
    have_idiomatic="$(cd / && mise settings get idiomatic_version_file_enable_tools 2> /dev/null)"
    if [[ "$(tr -d '[]" ' <<< "$have_idiomatic" | tr ',' '\n' | sort | xargs)" == "python ruby" ]]; then
        echo "OK:   mise follows .python-version and .ruby-version (option B)"
    else
        setters="$(grep -ls '^[[:space:]]*idiomatic_version_file_enable_tools' "$HOME/.config/mise/config.toml" /etc/mise/conf.d/*.toml 2> /dev/null | tr '\n' ' ')"
        report warn "mise's idiomatic_version_file_enable_tools is ${have_idiomatic:-unset}, not $want_idiomatic, so projects' version files are not all followed (set in: ${setters:-unknown}). Fix: mise settings add idiomatic_version_file_enable_tools python (and ruby), or remove the line from that file"
    fi
{{- end }}
{{- else }}
    case "$(readlink -f "$mise_bin" 2> /dev/null || echo "$mise_bin")" in
        */Cellar/*) mise_fix="brew upgrade mise" ;;
        *) mise_fix="mise self-update" ;;
    esac
    if [[ -n "$mise_v" ]] && version_ge "$mise_v" "$MISE_MIN"; then
        echo "OK:   mise $mise_v ($mise_bin)"
    else
        report warn "mise ${mise_v:-of unknown version} ($mise_bin) is older than $MISE_MIN, the release ~/.config/mise/config.toml was verified on. Fix: $mise_fix"
    fi
{{- end }}
    # A runtime ahead of mise's shims in a login shell wins in every project, pin or not. `uv python install`
    # puts such a python3 into ~/.local/bin, which ~/.zprofile places before the shims.
    shims="$HOME/.local/share/mise/shims"
    while IFS='=' read -r tool first; do
        [[ -e "$shims/$tool" && -n "$first" && "$first" != "$shims/$tool" ]] || continue
        report warn "$tool resolves to $first in a login shell, ahead of mise's shim, so projects get it instead of their pinned version. Fix: remove that link (for a uv Python, its versioned python3.X link can stay)"
    done < <(zsh -lc 'for t in python3 python ruby node go; do print -r -- "$t=$(whence -p $t)"; done' 2> /dev/null)
{{- if ne (dig "osRelease" "id" "" .chezmoi) "omarchy" }}
    {{- /* mise-audit is not deployed on Omarchy. */}}
    # The audit never installs anything; `mise-audit --install` does.
    if command -v mise-audit &> /dev/null; then
        if audit_out="$(mise-audit --quiet 2>&1)"; then
            echo "OK:   mise-audit: every project runtime pin under \$HOME is installed"
        else
            while IFS= read -r line; do echo "      $line"; done <<< "$audit_out"
            # Off the to-do list: a pin that cannot install (an old Ruby) stays listed until its project changes it.
            report warn "the project runtime pins above are not installed (a pin that cannot install stays listed until its project changes it). Fix: mise-audit --install" off-list
        fi
    fi
{{- end }}
fi

# Once per machine, by hand (docs/NEW_MACHINE.md): name each step not done yet. Informational: never fails the apply.
note() {
    echo "NOTE: $1"
    todo "$1"
}
if [[ -f "$HOME/.ssh/id_rsa" ]]; then
    echo "OK:   SSH key ~/.ssh/id_rsa"
else
    note "there is no SSH key at ~/.ssh/id_rsa, so GitHub over SSH and the hosts in ~/.ssh/config do not work. Fix: copy it from another machine (chmod 600), then run ssh-key-remember"
fi
if [[ -d "$HOME/.cfg" ]]; then
    echo "OK:   ~/.cfg (ai-tooling, guides, dotfiles-local)"
else
    note "the private ~/.cfg is not cloned, so ai-tooling, the guides and dotfiles-local are missing. Fix: docs/NEW_MACHINE.md in the chezmoi source, step \"Private files\""
fi
if [[ -d "$HOME/ai-tooling" ]]; then
    if [[ "$(readlink "$HOME/.claude/CLAUDE.md" 2> /dev/null)" == "$HOME/ai-tooling/claude/CLAUDE.md" ]]; then
        echo "OK:   ai-tooling is set up for Claude Code"
    else
        note "ai-tooling is not set up here (~/.claude/CLAUDE.md is not its link). Fix: cd ~/ai-tooling && make setup"
    fi
fi
{{- if eq .chezmoi.os "darwin" }}
# This Mac's own shell settings: ~/dotfiles-local (from ~/.cfg) reaches the shell through two links.
for local_file in zshrc.local aliases.local; do
    [[ -f "$HOME/dotfiles-local/$local_file" ]] || continue
    if [[ -e "$HOME/.$local_file" ]]; then
        echo "OK:   ~/.$local_file"
    else
        note "~/.$local_file is missing, so this Mac's own settings in ~/dotfiles-local are not loaded. Fix: ln -s ~/dotfiles-local/$local_file ~/.$local_file"
    fi
done
{{- end }}
if command -v gh &> /dev/null; then
    if [[ "$(gh config get git_protocol 2> /dev/null)" == ssh ]]; then
        echo "OK:   gh clones over SSH"
    else
        note "gh clones over https, so new clones get https remotes. Fix: gh config set git_protocol ssh"
    fi
    if gh auth token -h github.com &> /dev/null; then
        echo "OK:   gh is logged in to github.com"
{{- if eq .chezmoi.os "darwin" }}
    elif [[ -n "${SSH_CONNECTION:-}" ]]; then
        echo "NOTE: gh login not checked: its token is in the login Keychain, which is locked over SSH"
{{- end }}
    else
        note "gh is not logged in to github.com. Fix: gh auth login"
    fi
fi
# The work identity comes from the `chezmoi init` answers ([data.work]), the same on every host: without them,
# work repositories get the personal email.
{{- if dig "work" "enabled" false . }}
echo "OK:   work email for {{ len (dig "work" "org_list" list .) }} work GitHub orgs (~/.gitconfig.work)"
{{- else if eq (dig "work" "email" "" .) "none" }}
echo "OK:   no work email on this machine (answered none at chezmoi init)"
{{- else }}
note "no work email set, so git uses your personal email in every repository, work ones included. Fix: chezmoi init --prompt (answer none if this machine never has work repositories)"
{{- end }}
{{- if eq (dig "osRelease" "id" "" .chezmoi) "omarchy" }}
# LunarVim (lunarvim-git) needs a one-time link per user; never its init-lvim.sh.
if command -v lvim &> /dev/null; then
    if [[ -e "$HOME/.local/share/lunarvim/lvim" ]]; then
        echo "OK:   LunarVim is set up"
    else
        note "LunarVim is installed but not set up for you. Fix: mkdir -p ~/.local/share/lunarvim && ln -s /usr/share/lunarvim ~/.local/share/lunarvim/lvim && lvim --headless +qa"
    fi
fi
{{- end }}

# Apps that read a changed config only when they start or on a reload key. kitty, Wave, Hyprland and iTerm2's dynamic
# profiles reload by themselves; iTerm2's global settings are run_after_96's.
{{- if eq .chezmoi.os "darwin" }}
reload_hint "$HOME/.config/ghostty/config" ghostty "Ghostty's config changed: press Cmd+Shift+, in Ghostty to reload it, or open a new window"
{{- else }}
reload_hint "$HOME/.config/ghostty/config" ghostty "Ghostty's config changed: press Ctrl+Shift+, in Ghostty to reload it, or open a new window"
reload_hint "$HOME/.config/foot/foot.ini" foot "foot's config changed: new foot windows use it; open ones keep the old settings"
{{- end }}
reload_hint "$HOME/.config/herdr/config.toml" herdr "Herdr's config changed: run herdr server reload-config (or press Ctrl-b r in Herdr)"
reload_hint "$HOME/.config/tmux/tmux.conf" tmux "tmux's config changed: press Ctrl-b r in tmux"
for startup_file in .zshrc .zprofile .aliases; do
    reload_hint "$HOME/$startup_file" "" "Shell startup files changed: run exec zsh in open shells, or open new ones"
done

if [[ "$failed" -ne 0 ]]; then
    echo "==> Requirement check failed: commits on this machine are not fully secret-scanned."
    print_todo
    exit 1
fi

if [[ "$warned" -ne 0 ]]; then
    echo "==> Requirement check passed with warnings (WARN lines above)."
fi
print_todo
