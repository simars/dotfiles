# Own machines (names, how each is reached, host key aliases, agent forwarding) live in ~/.ssh/config.d/*.conf,
# which the private ~/.cfg repository provides, so this public repository names none of them. Until ~/.cfg is
# checked out the glob matches nothing and only the settings below apply.
Include config.d/*.conf

Host *
    AddKeysToAgent yes
    IdentitiesOnly yes
    StrictHostKeyChecking accept-new
{{- if eq .chezmoi.os "darwin" }}
    UseKeychain yes
{{- end }}

Host github.com
    HostName ssh.github.com
    Port 443
    User git
    IdentityFile ~/.ssh/id_rsa
