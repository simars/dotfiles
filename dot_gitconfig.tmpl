[user]
    name = {{ .name }}
    email = {{ .email }}

[init]
    defaultBranch = main

[push]
    default = current

[color]
    ui = auto

[alias]
    aa = add --all
    ap = add --patch
    branches = for-each-ref --sort=-committerdate --format="%(color:blue)%(authordate:relative)\t%(color:red)%(authorname)\t%(color:white)%(color:bold)%(refname:short)" refs/remotes
    ci = commit -v
    co = checkout
    pf = push --force-with-lease
    st = status

[core]
    excludesfile = ~/.gitignore
    autocrlf = input
{{- /* No editor on Omarchy: git then follows $EDITOR, Omarchy's launcher (omarchy-launch-editor). */}}
{{- if eq .chezmoi.os "darwin" }}
    editor = code --wait
{{- else if ne (dig "osRelease" "id" "" .chezmoi) "omarchy" }}
    editor = nvim
{{- end }}

[merge]
    ff = only

[commit]
    template = ~/.gitmessage

[fetch]
    prune = true

[rebase]
    autosquash = true

# Secret scan and identity/trailer guard on every commit/push in every repo
# (config-defined hooks, git 2.54+). A repo's own .git/hooks/* still runs after.
[hook "gitleaks"]
    event = pre-commit
    command = ~/.config/git/hooks/gitleaks-pre-commit

[hook "identity-pre-commit"]
    event = pre-commit
    command = ~/.config/git/hooks/git-identity-guard --pre-commit

[hook "identity-commit-msg"]
    event = commit-msg
    command = ~/.config/git/hooks/git-identity-guard --commit-msg

[hook "identity-pre-push"]
    event = pre-push
    command = ~/.config/git/hooks/git-identity-guard --pre-push

{{- if dig "work" "enabled" false . }}

# Work identity (from the `chezmoi init` answers): repositories in a work GitHub org, by remote or under ~/<org>/,
# commit with the email in ~/.gitconfig.work. Before ~/.gitconfig.local, so a machine-local setting still wins.
{{- range dig "work" "org_list" list . }}
[includeIf "hasconfig:remote.*.url:git@github.com:{{ . }}/**"]
    path = ~/.gitconfig.work
[includeIf "hasconfig:remote.*.url:https://github.com/{{ . }}/**"]
    path = ~/.gitconfig.work
[includeIf "gitdir:~/{{ . }}/"]
    path = ~/.gitconfig.work
{{- end }}
{{- end }}

[include]
    path = ~/.gitconfig.local

[diff]
    colorMoved = zebra
{{- /* No https-to-ssh rewrite for GitHub: it made every fetch need an unlocked SSH key (brew update, LazyVim, Omarchy
       plugins). Repositories store SSH URLs instead, and `gh config set git_protocol ssh` makes `gh repo clone` do so. */}}
