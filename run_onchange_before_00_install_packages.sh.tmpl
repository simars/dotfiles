#!/usr/bin/env bash
# packages.toml hash: {{ include ".chezmoidata/packages.toml" | sha256sum }}
set -euo pipefail

if [[ "${CHEZMOI_CI:-false}" == "true" ]]; then
    echo "==> CI environment detected: skipping system-level package installation."
    exit 0
fi

{{- $packages := index . "packages" | default . }}

{{ if eq .chezmoi.os "darwin" -}}
echo "==> Starting macOS Bootstrap ({{ .chezmoi.arch }})..."

# Verify Xcode Command Line Tools presence
if ! xcode-select -p &>/dev/null; then
    echo "==> Xcode Command Line Tools missing. Triggering install..."
    xcode-select --install 2>/dev/null || true
fi

# Evaluate existing Homebrew installation if present
if [[ -x "/opt/homebrew/bin/brew" ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x "/usr/local/bin/brew" ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi

if ! command -v brew &> /dev/null; then
{{- if eq .chezmoi.arch "arm64" }}
    echo "==> Installing Homebrew..."
    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    eval "$(/opt/homebrew/bin/brew shellenv)"
{{- else }}
    echo "WARNING: Homebrew not found and upstream installer does not support Intel macOS. Proceeding with standalone tools..."
{{- end }}
fi

if command -v brew &> /dev/null; then
    echo "==> Synchronizing Homebrew Formulae & Casks via Brew Bundle..."
    export HOMEBREW_NO_BOTTLE_SOURCE_FALLBACK=1
    if ! brew bundle --no-upgrade --file=/dev/stdin <<EOF
{{ range $packages.darwin.brew.formulae -}}
brew {{ . | quote }}
{{ end -}}
{{ range $packages.darwin.brew.casks -}}
cask {{ . | quote }}
{{ end -}}
EOF
    then
        echo "WARNING: Some Homebrew packages could not be installed (e.g. unbottled on this architecture). Continuing..."
    fi

    echo "==> Pruning orphaned Homebrew dependencies and cleaning cache..."
    brew autoremove || true
    brew cleanup -s || true
fi

# Standalone binary fallbacks for core CLI tools if Homebrew skipped them
mkdir -p "$HOME/.local/bin"
export PATH="$HOME/.local/bin:$PATH"

if ! command -v starship &> /dev/null; then
    echo "==> Installing Starship prompt fallback..."
    curl -sS https://starship.rs/install.sh | sh -s -- --yes --bin-dir "$HOME/.local/bin"
fi

if ! command -v mise &> /dev/null; then
    echo "==> Installing Mise runtime manager fallback..."
    curl https://mise.run | sh
fi

if ! command -v age &> /dev/null; then
    echo "==> Installing Age encryption fallback..."
    AGE_ARCH="{{ if eq .chezmoi.arch "arm64" }}arm64{{ else }}amd64{{ end }}"
    curl -fsSL "https://github.com/FiloSottile/age/releases/download/v1.3.2/age-v1.3.2-darwin-${AGE_ARCH}.tar.gz" | tar -xz -C "$HOME/.local/bin" --strip-components=1 age/age age/age-keygen
fi

if ! command -v zoxide &> /dev/null; then
    echo "==> Installing Zoxide directory jumper fallback..."
    curl -sS https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh | bash
fi

if ! command -v fzf &> /dev/null; then
    echo "==> Installing fzf fallback..."
    FZF_ARCH="{{ if eq .chezmoi.arch "arm64" }}arm64{{ else }}amd64{{ end }}"
    curl -fsSL "https://github.com/junegunn/fzf/releases/download/v0.56.3/fzf-0.56.3-darwin_${FZF_ARCH}.tar.gz" | tar -xz -C "$HOME/.local/bin" fzf 2>/dev/null || true
fi

{{ else if eq .chezmoi.os "linux" -}}
echo "==> Starting Ubuntu Linux Bootstrap ({{ .chezmoi.arch }})..."
export DEBIAN_FRONTEND=noninteractive

sudo apt-get update -y
sudo apt-get install -y \
{{- range $packages.ubuntu.apt.packages }}
    {{ . | quote }} \
{{- end }}
    ;

# Normalize fd-find binary name to fd on Ubuntu
mkdir -p "$HOME/.local/bin"
if command -v fdfind &> /dev/null && ! command -v fd &> /dev/null; then
    ln -sf "$(command -v fdfind)" "$HOME/.local/bin/fd"
fi

# Install Starship if missing
if ! command -v starship &> /dev/null; then
    echo "==> Installing Starship prompt..."
    curl -sS https://starship.rs/install.sh | sh -s -- --yes --bin-dir "$HOME/.local/bin"
fi

# Install Mise if missing
if ! command -v mise &> /dev/null; then
    echo "==> Installing mise polyglot runtime..."
    curl -fsSL https://mise.run | sh
fi

# Install Gitleaks if missing
if ! command -v gitleaks &> /dev/null; then
    echo "==> Installing Gitleaks..."
    GITLEAKS_VERSION="8.21.2"
    ARCH="$(dpkg --print-architecture)"
    if [[ "$ARCH" == "amd64" ]]; then GL_ARCH="x64"; else GL_ARCH="arm64"; fi
    curl -fsSL "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_${GL_ARCH}.tar.gz" \
        | sudo tar -xz -C /usr/local/bin gitleaks
fi

# Install Zoxide if missing
if ! command -v zoxide &> /dev/null; then
    echo "==> Installing Zoxide directory jumper..."
    curl -sS https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh | bash
fi

# Install JetBrainsMono Nerd Font on Linux if missing
FONT_DIR="$HOME/.local/share/fonts/JetBrainsMono"
if [[ ! -d "$FONT_DIR" ]]; then
    echo "==> Installing JetBrainsMono Nerd Font..."
    mkdir -p "$FONT_DIR"
    curl -fsSL "https://github.com/ryanoasis/nerd-fonts/releases/latest/download/JetBrainsMono.zip" -o /tmp/JetBrainsMono.zip
    unzip -q -o /tmp/JetBrainsMono.zip -d "$FONT_DIR"
    rm -f /tmp/JetBrainsMono.zip
    fc-cache -fv &> /dev/null || true
fi

# Install Official Docker Engine if missing
if ! command -v docker &> /dev/null; then
    echo "==> Installing Official Docker Engine..."
    sudo install -m 0755 -d /etc/apt/keyrings
    sudo curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
    sudo chmod a+r /etc/apt/keyrings/docker.asc
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
        | sudo tee /etc/apt/sources.list.d/docker.list > /dev/null
    sudo apt-get update -y
    sudo apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
fi

# Install 1Password CLI on Linux if missing
if ! command -v op &> /dev/null; then
    echo "==> Installing 1Password CLI..."
    curl -sS https://downloads.1password.com/linux/keys/1password.asc | sudo gpg --dearmor --output /usr/share/keyrings/1password-archive-keyring.gpg 2>/dev/null || true
    echo 'deb [arch=amd64 signed-by=/usr/share/keyrings/1password-archive-keyring.gpg] https://downloads.1password.com/linux/debian/amd64 stable main' | sudo tee /etc/apt/sources.list.d/1password.list > /dev/null || true
    sudo apt-get update -y && sudo apt-get install -y 1password-cli || true
fi

# Install Bitwarden CLI on Linux if missing
if ! command -v bw &> /dev/null; then
    echo "==> Installing Bitwarden CLI..."
    mkdir -p "$HOME/.local/bin"
    curl -fsSL "https://vault.bitwarden.com/download/?app=cli&platform=linux" -o /tmp/bw.zip 2>/dev/null || true
    if [[ -f /tmp/bw.zip ]]; then
        unzip -q -o /tmp/bw.zip -d "$HOME/.local/bin" 2>/dev/null || true
        chmod +x "$HOME/.local/bin/bw" 2>/dev/null || true
        rm -f /tmp/bw.zip
    fi
fi

if ! getent group docker > /dev/null; then
    sudo groupadd docker
fi
if ! id -nG "$USER" | grep -qw "docker"; then
    sudo usermod -aG docker "$USER"
fi
{{ end -}}
