#!/usr/bin/env bash
# packages.toml hash: {{ include ".chezmoidata/packages.toml" | sha256sum }}
set -euo pipefail

if [[ "${CHEZMOI_CI:-false}" == "true" ]]; then
    echo "==> CI environment detected: skipping system-level package installation."
    exit 0
fi

{{- $packages := index . "packages" | default . }}

{{ if and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "arm64") -}}
echo "==> Starting macOS Bootstrap ({{ .chezmoi.arch }})..."

# Verify Xcode Command Line Tools presence
if ! xcode-select -p &>/dev/null; then
    echo "==> Xcode Command Line Tools missing. Triggering install..."
    xcode-select --install 2>/dev/null || true
fi

# Evaluate existing Homebrew installation if present
if [[ -x "/opt/homebrew/bin/brew" ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

if ! command -v brew &> /dev/null; then
    echo "==> Installing Homebrew..."
    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

echo "==> Synchronizing Homebrew Formulae & Casks via Brew Bundle..."
# Give brew bundle the Brewfile as a file, not on stdin: its auto-update runs first and can start builds that inherit
# stdin. On 2026-10-20 the pkgconf rebuild after a macOS upgrade swallowed the whole Brewfile, and nothing installed.
brewfile="$(mktemp)"
cat > "$brewfile" <<EOF
{{ range $packages.darwin.brew.formulae -}}
brew {{ . | quote }}
{{ end -}}
{{ range $packages.darwin.brew.casks -}}
cask {{ . | quote }}
{{ end -}}
EOF
if ! brew bundle --no-upgrade --file="$brewfile" < /dev/null; then
    echo "WARNING: Some Homebrew packages could not be installed. Continuing..."
fi
rm -f "$brewfile"

echo "==> Pruning orphaned Homebrew dependencies and cleaning cache..."
brew autoremove || true
brew cleanup -s || true

if ! command -v lvim &> /dev/null; then
    echo "==> Installing LunarVim..."
    bash <(curl -fsSL https://raw.githubusercontent.com/lunarvim/lunarvim/master/utils/installer/install.sh) --yes --no-install-dependencies || true
fi
{{ else if eq .chezmoi.os "darwin" -}}
{{- /* Intel Macs: Homebrew compiles any formula without an Intel bottle there (one apply built llvm, rust and node for 7
       hours), so this repository installs nothing on them. docs/INTEL_MACS.md says what to install by hand. */}}
echo "==> Skipping packages: Intel Macs are set up by hand (docs/INTEL_MACS.md in the chezmoi source)."
{{ else if eq (dig "osRelease" "id" "" .chezmoi) "omarchy" -}}
{{- /* Omarchy: only the packages listed in packages.toml, only through Omarchy's own commands. They need sudo, so
       they run only from a terminal; otherwise the command is printed and the apply carries on. The requirement check
       after every apply keeps reporting what is still missing. */}}
# Each package on its own: `omarchy pkg missing` is true when any of the packages it is given is missing.
missing() {
    local package
    for package in "$@"; do
        if omarchy pkg missing "$package"; then
            printf '%s\n' "$package"
        fi
    done
}

install_missing() { # install_missing "pkg add" | "pkg aur add", then the packages
    local subcommand="$1"
    shift
    local -a need
    mapfile -t need < <(missing "$@")
    if [[ ${#need[@]} -eq 0 ]]; then
        echo "==> Omarchy packages ($subcommand): all installed."
    elif [[ -t 0 && -t 1 ]]; then
        echo "==> Installing with omarchy $subcommand: ${need[*]}"
        # AUR builds run whatever `python` is first on PATH. After `omarchy install dev-env python` that is mise's,
        # which has no setuptools, so neovim-remote (for lunarvim-git) fails to build; use the system one.
        # shellcheck disable=SC2086
        if ! PATH="/usr/bin:$PATH" omarchy $subcommand "${need[@]}"; then
            echo "WARNING: omarchy $subcommand failed. Run it yourself: omarchy $subcommand ${need[*]}"
        fi
    else
        echo "==> Not a terminal, so nothing is installed. Run: omarchy $subcommand ${need[*]}"
    fi
}

install_missing "pkg add"{{ range $packages.omarchy.pacman }} {{ . | quote }}{{ end }}
install_missing "pkg aur add"{{ range $packages.omarchy.aur }} {{ . | quote }}{{ end }}
{{ else -}}
{{- /* Other Linux hosts (Arch, Ubuntu) bring their own packages; this repository manages only their dotfiles. */}}
echo "==> Skipping system packages: {{ dig "osRelease" "id" "" .chezmoi | default "this Linux" }} installs them with its own package manager."
{{ end -}}
