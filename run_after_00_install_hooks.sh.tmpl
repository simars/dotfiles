#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
HOOK_DIR="{{ .chezmoi.sourceDir }}/.git/hooks"

if [[ -d "${HOOK_DIR}" ]]; then
    cat << 'EOF' > "${HOOK_DIR}/pre-commit"
#!/usr/bin/env bash
set -e

# Canary: git older than the minimum silently skips the global gitleaks hook in every other repo.
GIT_MIN="{{ .requirements.git.min }}"
GIT_V="$(git --version | awk '{print $3}')"
if [[ "$(printf '%s\n%s\n' "$GIT_V" "$GIT_MIN" | sort -V | head -n 1)" != "$GIT_MIN" ]]; then
    echo "WARNING: git $GIT_V is older than $GIT_MIN: the global gitleaks hook is NOT scanning your other repos."
fi

if ! command -v gitleaks &> /dev/null; then
    echo "WARNING: 'gitleaks' binary not found. Skipping staged secret scan."
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
echo "==> Running Gitleaks secret scan on staged changes..."

if ! gitleaks protect --staged --verbose --config "${REPO_ROOT}/.gitleaks.toml"; then
    echo "=========================================================================="
    echo " COMMIT ABORTED: Gitleaks detected potential unencrypted secrets!"
    echo " Encrypt sensitive files first using: chezmoi add --encrypt <file>"
    echo "=========================================================================="
    exit 1
fi
EOF
    chmod +x "${HOOK_DIR}/pre-commit"
fi
