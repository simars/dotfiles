# Omarchy's portable shell helpers and keys, for hosts without Omarchy (interactive zsh; ~/.zshrc sources this file).
# Generated by chezmoi from the snapshots in docs/omarchy-stock/shell/ of the chezmoi source, so it is Omarchy's own
# code. On Omarchy, ~/.zshrc loads Omarchy's live files instead and this file is not deployed. Do not edit it here:
# when the drift report after `chezmoi apply` on Omarchy shows a change, refresh the snapshot.
# Not taken over (see docs/ZSH_UNIFICATION.md): Linux-only helpers (a, rsw/lsw/dsw, iso2sd, format-drive, open) and,
# until decided, cd as zoxide (zd), r as rails, compress and the reconnecting ssh.

# --- Omarchy: default/bash/aliases ---
{{ include "docs/omarchy-stock/shell/aliases" | replace "file=$(find . -type f" "file=$(${commands[gfind]:-find} . -type f" | trimSuffix "\n" }}

# --- Omarchy: default/bash/fns (compression, herdr, ssh-port-forwarding, tmux, worktrees) ---
{{ range list "compression" "herdr" "ssh-port-forwarding" "tmux" "worktrees" -}}
{{ include (printf "docs/omarchy-stock/shell/%s" .) | trimSuffix "\n" }}

{{ end -}}
# Taken back out: macOS has its own open and compress; a is Omarchy's agent; cd, r are not decided yet.
unalias a cd r 2> /dev/null
unfunction zd open compress 2> /dev/null

# --- Omarchy: the fzf keys from omarchy-zsh's zoptions (Ctrl+Alt+F files, Ctrl+Alt+L git log, Ctrl+Alt+V variables).
# The file widget is renamed: fzf's own setup, loaded later, defines fzf-file-widget for Ctrl-T and would replace it.
{{ include "docs/omarchy-stock/shell/zoptions" | regexFind "(?s)# fzf ZLE widgets\n.*?\nfi\n" | replace "fzf-file-widget" "fzf-find-files-widget" | trimSuffix "\n" }}
