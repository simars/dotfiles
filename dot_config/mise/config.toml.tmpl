[tools]
go = "latest"
python = "3.12"
node = "22"
# No global ruby on purpose: outside a project, `ruby` stays the system /usr/bin/ruby that macOS tooling
# expects. Projects get theirs from .ruby-version, a Gemfile `ruby` line or .tool-versions (see below).

[settings]
experimental = true
# Read the version files projects already carry: .ruby-version and Gemfile `ruby` lines, .python-version,
# .nvmrc and .node-version. Without this, mise ignores them and the system runtime answers silently.
# Go is left out: mise would read `go 1.17` in go.mod as a pin for that old release, while Go itself already
# builds older modules on the newest toolchain. Pin Go per project in .tool-versions or mise.toml instead.
idiomatic_version_file_enable_tools = ["node", "python", "ruby"]

[settings.python]
uv_venv_auto = true
default_packages_file = "~/.config/mise/default-python-packages"

[settings.go]
# Leave GOBIN unset, so `go install` writes to ~/go/bin (on PATH via ~/.zprofile) instead of the Go version's
# own bin directory, which `go = "latest"` replaces on every Go upgrade.
set_gobin = false
{{- if and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "arm64") }}

[settings.ruby]
# Apple silicon gets prebuilt, attestation-checked Rubies. Fail fast on a version with no prebuilt build
# (the EOL 2.x line) instead of compiling it against an OpenSSL that Homebrew no longer ships.
# One-off override: MISE_RUBY_COMPILE=true mise install ruby@<version>
compile = false
{{- end }}
