[tools]
go = "latest"
python = { version = "3.12", postinstall = "test -f ~/.config/mise/default-python-packages && $MISE_TOOL_INSTALL_PATH/bin/python -m pip install -r ~/.config/mise/default-python-packages || true" }
node = "22"
# No global ruby on purpose: outside a project, `ruby` stays the system /usr/bin/ruby that macOS tooling
# expects. Projects get theirs from .ruby-version, a Gemfile `ruby` line or .tool-versions (see below).

[settings]
experimental = true
{{ template "mise-shared-settings.toml" . }}
{{- if eq .chezmoi.os "darwin" }}

[settings.ruby]
# Never compile Ruby implicitly on macOS. Apple silicon gets prebuilt, attestation-checked Rubies; a version with
# none (the EOL 2.x line) fails at once instead of compiling against an OpenSSL that Homebrew no longer ships.
# Intel Macs have no prebuilt Rubies at all, so without this a `ruby` call in any pinned project would start a
# long compile through auto-install. Compile on purpose: MISE_RUBY_COMPILE=true mise install ruby@<version>
compile = false
{{- end }}
