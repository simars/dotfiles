#!/usr/bin/env bash
# chezmoi modify script for Ghostty's ~/.config/ghostty/config: Omarchy ships this file (and its theme include), so
# only these settings are set and everything else is kept. Selecting text copies it to the clipboard, as in every
# other terminal{{ if eq .chezmoi.os "darwin" }}; left Option is Alt, right Option types special characters{{ else }}; and Ghostty gives back keys the programs inside need{{ end }}.
# Closing asks first, and a leader key gives Ghostty's tabs and splits tmux's letters.
# Cheatsheet: "Copy and Paste", "Option as Alt in the Mac Terminals", "Keys the Terminal Must Not Take",
# "Terminal Tabs and Splits".
set -euo pipefail
MARKER="# Set by chezmoi (dot_config/ghostty/modify_config.tmpl); edits to these lines are replaced on apply"
{{- if eq .chezmoi.os "darwin" }}
BLOCK=$'copy-on-select = clipboard\nmacos-option-as-alt = left'
{{- else }}
BLOCK='copy-on-select = clipboard'
# Ghostty's Linux defaults take these keys even when the action cannot run (no `performable:`), so the program never
# sees them: Ctrl+Enter is full screen there (Claude Code: send queued messages now; Super+F is full screen on
# Omarchy), Alt+1..9 go to a Ghostty tab and Ctrl+Alt+arrows to a Ghostty split (Herdr's go-to-tab and focus-pane
# keys). `unbind` passes them on. Ghostty's own tabs still switch with Ctrl+Tab and Ctrl+PgUp/PgDn. The Mac's Ghostty
# uses Cmd for all of these.
for key in ctrl+enter alt+{1..9} alt+digit_{1..9} ctrl+alt+arrow_{up,down,left,right}; do
    BLOCK+=$'\n'"keybind = $key=unbind"
done
{{- end }}
# Every close asks first while a program runs in the split, as tmux and Herdr do (Omarchy ships false).
BLOCK+=$'\nconfirm-close-surface = true'
# The terminal leader: {{ if eq .chezmoi.os "darwin" }}Cmd-b{{ else }}Super-b (Omarchy's Super is the Mac's Cmd){{ end }}, then the key tmux uses after Ctrl-b, for Ghostty's own
# tabs and splits (cheatsheet: "Terminal Tabs and Splits"). The leader opens key table `term`; every action closes it
# again (chain=deactivate_key_table), and any other key closes it and is swallowed, never typed into the program.
# Ghostty matches modifiers exactly, so tmux's shifted keys are written with shift (% is shift+digit_5), and a bare
# Shift or Alt press, itself a key event, is ignored so it cannot close the table before Shift+5 or Alt+arrow arrives. As after
# tmux's and Herdr's prefix, r reloads and Alt+arrows resize (40 px, about tmux's 5 cells); Alt+arrows then open table
# `term_resize`, where h j k l / arrows (20 px) and Alt+arrows (40 px) keep resizing until Esc or Enter. Never
# Ctrl+arrows: macOS takes them (Spaces, Mission Control) before Ghostty sees them.
LEADER={{ if eq .chezmoi.os "darwin" }}cmd+b{{ else }}super+b{{ end }}
lead() { BLOCK+=$'\n'"keybind = $1=$2"; }
act() { lead "term/$1" "$2"; BLOCK+=$'\nkeybind = chain=deactivate_key_table'; }
lead "$LEADER" activate_key_table:term
for mod_key in shift_left shift+shift_left shift_right shift+shift_right alt_left alt+alt_left alt_right alt+alt_right; do
    lead "term/$mod_key" ignore
done
lead term/catch_all deactivate_key_table
lead term/escape deactivate_key_table
act c new_tab
act shift+digit_5 new_split:right
act v new_split:right
act shift+quote new_split:down
act - new_split:down
for pair in h:left j:down k:up l:right; do
    act "${pair%%:*}" "goto_split:${pair#*:}"
    act "arrow_${pair#*:}" "goto_split:${pair#*:}"
done
act ';' goto_split:previous
act o goto_split:next
act x close_surface
act z toggle_split_zoom
for n in 1 2 3 4 5 6 7 8 9; do act "digit_$n" "goto_tab:$n"; done
act n next_tab
act p previous_tab
act , prompt_tab_title
act shift+digit_7 close_tab
act equal equalize_splits
act shift+e equalize_splits
act shift+slash toggle_command_palette
act r reload_config
for dir in left down up right; do
    act "alt+arrow_$dir" "resize_split:$dir,40"
    BLOCK+=$'\nkeybind = chain=activate_key_table:term_resize'
done
for pair in h:left j:down k:up l:right; do
    lead "term_resize/${pair%%:*}" "resize_split:${pair#*:},20"
    lead "term_resize/arrow_${pair#*:}" "resize_split:${pair#*:},20"
    lead "term_resize/alt+arrow_${pair#*:}" "resize_split:${pair#*:},40"
done
lead term_resize/escape deactivate_all_key_tables
lead term_resize/enter deactivate_all_key_tables
lead term_resize/catch_all ignore
{{ template "kv-settings.awk.sh" . }}
