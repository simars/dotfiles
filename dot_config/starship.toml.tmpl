format = """
$os$directory$git_branch$git_status$docker_context\
$line_break$character"""

[directory]
style = "bold blue"
truncate_to_repo = true

[git_branch]
symbol = "🌱 "
style = "bold magenta"

[character]
success_symbol = "[⚡ ❯](bold green)"
error_symbol = "[❌ ❯](bold red)"

[docker_context]
symbol = "🐳 "
style = "bold cyan"
only_with_files = true
