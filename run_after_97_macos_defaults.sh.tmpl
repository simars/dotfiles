{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
# macOS only, after every apply: the same macOS settings on every Mac (cheatsheet: "Same macOS Settings on Every Mac").
# Writes each key listed in .chezmoidata/macos.toml ([[macos_defaults]]) where this Mac's value differs, so a change
# made in System Settings goes back at the next apply. Then restarts the Dock, Finder or Control Center when one of
# their keys was written (only while they run, so never before someone logs in), and lists "log out and back in" for
# keys macOS reads only at login (trackpad, scrolling, appearance, Spotlight's menu-bar icon). Then checks, read-only,
# the remote access a script can't turn on without sudo or System Settings (Remote Login, Screen Sharing, wake for
# network access on AC) and lists what is off. Informational: never fails the apply. Runs under bash 3.2 (Intel Macs
# without Homebrew's bash).
set -u
{{ template "after-apply.sh" . }}

updated=()
failed=()
effects=" "
ensure_default() { # ensure_default EFFECT -currentHost|- SAME_WHEN_UNSET(1|0) DOMAIN KEY TYPE VALUE
    local effect="$1" host="$2" unset_ok="$3" domain="$4" key="$5" type="$6" value="$7" want have
    [[ "$host" == "-" ]] && host=""
    case "$type $value" in
        "-bool true") want=1 ;;
        "-bool false") want=0 ;;
        *) want="$value" ;;
    esac
    if have="$(defaults ${host:+"$host"} read "$domain" "$key" 2> /dev/null)"; then
        [[ "$have" == "$want" ]] && return 0
        # defaults prints a decimal its own way (2.5, 0.15): compare floats as numbers.
        [[ "$type" == "-float" ]] && awk -v a="$have" -v b="$want" 'BEGIN { exit !(a + 0 == b + 0) }' && return 0
    else
        [[ "$unset_ok" == 1 ]] && return 0
    fi
    if defaults ${host:+"$host"} write "$domain" "$key" "$type" "$value"; then
        updated+=("$key")
        effects="$effects$effect "
    else
        failed+=("$domain $key")
    fi
}
{{ range $group := .macos_defaults -}}
{{   $host := ternary "-currentHost" "-" (dig "current_host" false $group) -}}
{{   $unset := dig "same_when_unset" list $group -}}
{{   range $domain := $group.domains -}}
{{     range $key, $value := $group.set -}}
ensure_default {{ $group.takes_effect | squote }} {{ $host }} {{ if has $key $unset }}1{{ else }}0{{ end }} {{ $domain | squote }} {{ $key | squote }} {{ if kindIs "bool" $value }}-bool {{ $value }}{{ else if kindIs "float64" $value }}-float {{ $value }}{{ else if kindIs "string" $value }}-string {{ $value | replace "$HOME" $.chezmoi.homeDir | squote }}{{ else }}-int {{ $value }}{{ end }}
{{     end -}}
{{   end -}}
{{ end -}}
join() { printf '%s\n' "$@" | awk '!seen[$0]++' | paste -sd, - | sed 's/,/, /g'; } # unique, in order

# macOS's own "Switch to Desktop N" shortcuts (ids 118-133), on the hidden combination in .chezmoidata/macos.toml
# (desktop_shortcuts), which Hammerspoon's window keys press. defaults' text form is read once: one line per entry,
# "ID ENABLED CODE MASK" (CODE and MASK empty when macOS stores no value), the last entry for an id winning.
hotkeys_now="$(defaults read com.apple.symbolichotkeys AppleSymbolicHotKeys 2> /dev/null | awk '
    /^    [0-9]+ = / { if (id != "") print id, en, p[2], p[3]; id = $1; en = ""; n = 0; delete p; next }
    id != "" && /enabled = / { en = $3; sub(/;/, "", en) }
    id != "" && /^ +[0-9]+,?$/ { v = $1; sub(/,/, "", v); p[++n] = v }
    END { if (id != "") print id, en, p[2], p[3] }')"
hotkey() { printf '%s\n' "$hotkeys_now" | awk -v id="$1" '$1 == id { l = $0 } END { print l }'; } # hotkey ID
desktop_keys_written=0
ensure_desktop_key() { # ensure_desktop_key ID CODE MASK
    [[ "$(hotkey "$1")" == "$1 1 $2 $3" ]] && return 0
    if defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add "$1" \
        "<dict><key>enabled</key><true/><key>value</key><dict><key>parameters</key><array><integer>65535</integer><integer>$2</integer><integer>$3</integer></array><key>type</key><string>standard</string></dict></dict>"; then
        desktop_keys_written=$((desktop_keys_written + 1))
    else
        failed+=("com.apple.symbolichotkeys $1")
    fi
}
{{ range $i, $key := .desktop_shortcuts.keys -}}
ensure_desktop_key {{ add 118 $i }} {{ $key.code }} {{ $.desktop_shortcuts.mask }}
{{ end -}}
# Ctrl+Space is tmux's and Herdr's second prefix; macOS's "Select the previous input source" (id 60) takes it first.
# These Macs never switch input language, so it is turned off (macOS's own parameters kept: space, Ctrl).
set -- $(hotkey 60)
if [[ "${2:-}" != 0 ]]; then
    if defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 60 \
        "<dict><key>enabled</key><false/><key>value</key><dict><key>parameters</key><array><integer>32</integer><integer>49</integer><integer>262144</integer></array><key>type</key><string>standard</string></dict></dict>"; then
        updated+=("input-source shortcut off")
        desktop_keys_written=$((desktop_keys_written + 1))
    else
        failed+=("com.apple.symbolichotkeys 60")
    fi
fi
if [[ $desktop_keys_written -gt 0 ]]; then
    [[ "${updated[*]:-}" == *"input-source shortcut off"* && $desktop_keys_written -eq 1 ]] || updated+=("desktop shortcuts")
    # Without this, macOS reads changed shortcuts only at the next login.
    if ! "${ACTIVATE_SETTINGS:-/System/Library/PrivateFrameworks/SystemAdministration.framework/Resources/activateSettings}" -u > /dev/null 2>&1; then
        echo "NOTE: macOS did not reload its keyboard shortcuts, so the window keys' desktops work only after a log out"
        todo "Log out of macOS and back in, so the desktop shortcuts (window keys) take effect"
    fi
fi
# Invert Colors (Accessibility, id 21) is Ctrl+Option+Cmd+8 unless changed: turned on, macOS takes the window key for
# desktop 8 first.
set -- $(hotkey 21)
if [[ "${2:-}" == 1 && ( -z "${3:-}" || "${3:-} ${4:-}" == "28 1835008" ) ]]; then
    echo "NOTE: macOS's Invert Colors shortcut (Ctrl+Option+Cmd+8) takes the window key for desktop 8"
    todo "Turn off System Settings > Keyboard > Keyboard Shortcuts > Accessibility > Invert colors, so Ctrl+Option+Cmd+8 reaches the window keys"
fi

if [[ ${#failed[@]} -gt 0 ]]; then
    echo "NOTE: macOS settings could not be written: $(join "${failed[@]}")"
    todo "Set these macOS settings by hand (System Settings), or find why defaults could not write them: $(join "${failed[@]}")"
fi
if [[ ${#updated[@]} -eq 0 ]]; then
    [[ ${#failed[@]} -gt 0 ]] || echo "OK:   macOS settings match the repo"
else
    restarted=()
    for process in Dock Finder ControlCenter; do
        [[ "$effects" == *" $process "* ]] || continue
        pgrep -xq "$process" && killall "$process" 2> /dev/null && restarted+=("$process")
    done
    message="OK:   macOS settings updated: $(join "${updated[@]}")"
    [[ ${#restarted[@]} -eq 0 ]] || message="$message; restarted $(join "${restarted[@]}")"
    [[ "$effects" == *" reopen "* ]] && message="$message; apps pick up the title-bar, scroll-bar and key-repeat settings when reopened"
    echo "$message"
    if [[ "$effects" == *" logout "* ]]; then
        echo "NOTE: some of these macOS settings take effect only after you log out and back in"
        todo "Log out of macOS and back in, so the updated trackpad, scrolling, appearance and menu-bar settings take effect"
    fi
fi

# Remote access (docs/NEW_MACHINE.md): reported only, because turning these on needs sudo or System Settings. A
# launchd job that is loaded means the service is on (macOS unloads sshd and screensharing when they are turned off);
# no sudo needed, so it reads the same over SSH.
off=()
launchctl print system/com.openssh.sshd > /dev/null 2>&1 || {
    off+=("Remote Login")
    todo "Turn on Remote Login (SSH into this Mac): System Settings > General > Sharing > Remote Login"
}
launchctl print system/com.apple.screensharing > /dev/null 2>&1 || {
    off+=("Screen Sharing")
    todo "Turn on Screen Sharing: System Settings > General > Sharing > Remote Management (or Screen Sharing)"
}
# Wake for network access on AC lets home-network traffic wake a sleeping Mac (SSH through .local). Macs without an
# AC section in pmset (none so far) are not checked.
womp="$(pmset -g custom 2> /dev/null | awk '/^AC Power:/ { ac = 1; next } /^[A-Za-z].*:$/ { ac = 0 } ac && $1 == "womp" { print $2; exit }')"
if [[ "$womp" == 0 ]]; then
    off+=("wake for network access on AC")
    todo "Turn on wake for network access when plugged in: sudo pmset -c womp 1"
fi
if [[ ${#off[@]} -eq 0 ]]; then
    echo "OK:   remote access: Remote Login, Screen Sharing${womp:+, wake for network access on AC}"
else
    echo "NOTE: remote access off on this Mac: $(join "${off[@]}")"
fi
exit 0
{{ end -}}
