# ==============================================================================
# General & Development Shell Aliases
# ==============================================================================

# Core Unix helpers
alias ll="ls -lah"
alias ln="ln -v"
alias mkdir="mkdir -p"
alias e="$EDITOR"
# VISUAL is often unset (Omarchy sets only EDITOR); fall back so `v` is never an empty alias.
alias v="${VISUAL:-$EDITOR}"

# Bundler & Rails
alias b="bundle"
alias migrate="bin/rails db:migrate db:rollback && bin/rails db:migrate db:test:prepare"
alias s="rspec"

# Path Inspection
alias path='echo $PATH | tr -s ":" "\n"'


# ==============================================================================
# Modern CLI Tool Enhancements
# ==============================================================================

# eza: Modern directory listing with git status & icons
if command -v eza &> /dev/null; then
    alias ll="eza -la --icons --git"
    # Omarchy defines its own lt (with --long --git); keep that one where it exists.
    alias lt > /dev/null 2>&1 || alias lt="eza --tree --level=2 --icons"
    alias ltree="eza --tree --icons"
fi

# bat: Syntax-highlighted viewer & dynamic interactive preview
if command -v bat &> /dev/null; then
    alias preview="bat"
    if command -v fzf &> /dev/null; then
        # Preview files dynamically using fzf and bat as you type
        alias fp="fzf --preview 'bat --style=numbers --color=always --line-range :500 {}'"
    fi
fi

# duf: Human-friendly disk usage table
if command -v duf &> /dev/null; then
    alias dfh="duf"
fi

# dust: Visual disk usage tree
if command -v dust &> /dev/null; then
    alias duh="dust"
fi

# btop: Resource & GPU monitor
if command -v btop &> /dev/null; then
    alias top="btop"
fi

# ==============================================================================
# chezmoi, tmux and Docker helpers
# ==============================================================================
alias cz="chezmoi"
alias tm="tmux new-session -A -s main"

# Stop every docker compose project in the subdirectories of the current directory
dkill() {
    local d
    for d in */; do
        if [[ -f "${d}docker-compose.yml" || -f "${d}docker-compose.yaml" ]]; then
            (cd "$d" && docker compose down)
        fi
    done
}
alias dprune="docker system prune -a --volumes -f"

# Workstation Cheatsheet Viewer
cheat() {
  local sheet="$HOME/.cheatsheet.md"
  if [ ! -f "$sheet" ]; then
    sheet="$HOME/.local/share/chezmoi/docs/CHEATSHEET.md"
  fi

  if [ ! -f "$sheet" ]; then
    echo "Error: Cheatsheet not found at ~/.cheatsheet.md or ~/.local/share/chezmoi/docs/CHEATSHEET.md" >&2
    return 1
  fi

  if command -v bat &> /dev/null; then
    bat --style=plain --paging=auto "$sheet"
  elif command -v less &> /dev/null; then
    less -RF "$sheet"
  else
    cat "$sheet"
  fi
}
cheatsheet() {
  cheat "$@"
}

# ==============================================================================
# 1Password-aware command runner
# ==============================================================================
# Runs a command under `op run` when ./.op-env or ./.env exists.
# ./.op-env lists 1Password Environment IDs, one per line (# comments allowed);
# each becomes an --environment flag, and the last one wins on name clashes.
# ./.env is passed as --env-file so op:// references in it resolve, and a
# legacy OP_TARGET_ENVIRONMENT=<id> line in it adds one more Environment.
# With neither file the command runs untouched.
# The flags live in an array: zsh does not word-split an unquoted $var, so a
# plain string would reach `op` as one argument there.
with-op() {
  local -a flags=()
  local line
  if [ -f .op-env ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      line=${line%%#*}
      line=$(printf '%s' "$line" | tr -d " \t\"'")
      [ -n "$line" ] && flags+=(--environment "$line")
    done < .op-env
  fi
  if [ -f .env ]; then
    line=$(grep -E "^OP_TARGET_ENVIRONMENT=" .env | cut -d'=' -f2 | tr -d "\"'")
    [ -n "$line" ] && flags+=(--environment "$line")
    flags+=(--env-file=.env)
  fi
  if [ ${#flags[@]} -eq 0 ]; then
    "$@"
    return
  fi

  # --no-masking: with secrets loaded, op run pipes stdout/stderr through a
  # masking filter, so interactive TUIs (claude, cursor) see no TTY and claude
  # falls into --print mode.
  op run --no-masking "${flags[@]}" -- "$@"
}

alias cld="with-op claude"
alias csr="with-op cursor ."

# ==============================================================================
# Local User Overrides (~/.aliases.local)
