# ==============================================================================
# General & Development Shell Aliases
# ==============================================================================

# Core Unix helpers
# ls is the system's own ls on every host, in colour when the output is a terminal (only colour: flags, sort order and
# piped output stay standard, so `ls -ltr` and pasted commands work). On Omarchy this replaces its eza `ls` on purpose;
# eza stays under ll, lt and ltree. On macOS, `userland gnu` later turns this into `gls --color=auto`. Checked first,
# because Apple's ls before macOS 13 has no --color.
if command ls --color=auto -d / > /dev/null 2>&1; then
    alias ls='ls --color=auto'
else
    unalias ls 2> /dev/null
fi
alias ll="ls -lah"
alias ln="ln -v"
alias mkdir="mkdir -p"
alias e="$EDITOR"
# VISUAL is often unset (Omarchy sets only EDITOR); fall back so `v` is never an empty alias.
alias v="${VISUAL:-$EDITOR}"

# Bundler & Rails
alias b="bundle"
alias migrate="bin/rails db:migrate db:rollback && bin/rails db:migrate db:test:prepare"
alias s="rspec"

# Plain cd on every host: Omarchy aliases cd to its zoxide wrapper zd, where a mistyped folder jumps elsewhere and
# zsh's cd -2 / cd old new stop working. z and zi still jump by frecency. The one Omarchy name replaced here besides ls.
if alias cd 2> /dev/null | grep -q 'zd'; then
    unalias cd
fi

# Parent directories (Omarchy's names; it defines them first, so keep its own where they exist)
alias .. > /dev/null 2>&1 || alias ..='cd ..'
alias ... > /dev/null 2>&1 || alias ...='cd ../..'
alias .... > /dev/null 2>&1 || alias ....='cd ../../..'

# Path Inspection
alias path='echo $PATH | tr -s ":" "\n"'


# ==============================================================================
# Modern CLI Tool Enhancements
# ==============================================================================

# eza: Modern directory listing with git status & icons
if command -v eza &> /dev/null; then
    alias ll="eza -la --icons --git"
    # The same as Omarchy's lt; Omarchy defines it first, so keep its own where it exists.
    alias lt > /dev/null 2>&1 || alias lt="eza --tree --level=2 --long --icons --git"
    alias ltree="eza --tree --icons"
fi

# bat: Syntax-highlighted viewer & dynamic interactive preview
if command -v bat &> /dev/null; then
    alias preview="bat"
    if command -v fzf &> /dev/null; then
        # Preview files dynamically using fzf and bat as you type
        alias fp="fzf --preview 'bat --style=numbers --color=always --line-range :500 {}'"
    fi
fi

# duf: Human-friendly disk usage table
if command -v duf &> /dev/null; then
    alias dfh="duf"
fi

# dust: Visual disk usage tree
if command -v dust &> /dev/null; then
    alias duh="dust"
fi

# btop: Resource & GPU monitor
if command -v btop &> /dev/null; then
    alias top="btop"
fi

# ==============================================================================
# chezmoi, tmux and Docker helpers
# ==============================================================================
alias cz="chezmoi"
alias tm="tmux new-session -A -s main"

# Stop every docker compose project in the subdirectories of the current directory
dkill() {
    local d
    for d in */; do
        if [[ -f "${d}docker-compose.yml" || -f "${d}docker-compose.yaml" ]]; then
            (cd "$d" && docker compose down)
        fi
    done
}
alias dprune="docker system prune -a --volumes -f"

# Workstation Cheatsheet Viewer
cheat() {
  local sheet="$HOME/.cheatsheet.md"
  if [ ! -f "$sheet" ]; then
    sheet="$HOME/.local/share/chezmoi/docs/CHEATSHEET.md"
  fi

  if [ ! -f "$sheet" ]; then
    echo "Error: Cheatsheet not found at ~/.cheatsheet.md or ~/.local/share/chezmoi/docs/CHEATSHEET.md" >&2
    return 1
  fi

  if command -v bat &> /dev/null; then
    bat --style=plain --paging=auto "$sheet"
  elif command -v less &> /dev/null; then
    less -RF "$sheet"
  else
    cat "$sheet"
  fi
}
cheatsheet() {
  cheat "$@"
}

# ==============================================================================
# 1Password-aware command runner
# ==============================================================================
# Runs a command under `op run` when ./.op-env or ./.env exists.
# ./.op-env lists 1Password Environment IDs, one per line (# comments allowed);
# each becomes an --environment flag, and the last one wins on name clashes.
# ./.env is passed as --env-file so op:// references in it resolve, and a
# legacy OP_TARGET_ENVIRONMENT=<id> line in it adds one more Environment.
# With neither file the command runs untouched.
# The flags live in an array: zsh does not word-split an unquoted $var, so a
# plain string would reach `op` as one argument there.
with-op() {
  local -a flags=()
  local line
  if [ -f .op-env ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      line=${line%%\#*} # \#: under zsh's EXTENDED_GLOB a bare # is a glob operator
      line=$(printf '%s' "$line" | tr -d " \t\"'")
      [ -n "$line" ] && flags+=(--environment "$line")
    done < .op-env
  fi
  if [ -f .env ]; then
    line=$(grep -E "^OP_TARGET_ENVIRONMENT=" .env | cut -d'=' -f2 | tr -d "\"'")
    [ -n "$line" ] && flags+=(--environment "$line")
    flags+=(--env-file=.env)
  fi
  if [ ${#flags[@]} -eq 0 ]; then
    "$@"
    return
  fi

  # --no-masking: with secrets loaded, op run pipes stdout/stderr through a
  # masking filter, so interactive TUIs (claude, cursor) see no TTY and claude
  # falls into --print mode.
  op run --no-masking "${flags[@]}" -- "$@"
}

# Agent shortcuts, one scheme for every agent: plain = the tool's own name, o = under with-op (project 1Password
# secrets; Claude, Copilot and Cursor only), y = the tool's no-prompt flag, oy = both. Each exists only where its
# tool is installed.
if command -v claude &> /dev/null; then
  alias cldo="with-op claude"
  alias cldy="claude --dangerously-skip-permissions"
  alias cldoy="with-op claude --dangerously-skip-permissions"
fi
if command -v copilot &> /dev/null; then
  alias cplo="with-op copilot"
  alias cply="copilot --yolo"
  alias cploy="with-op copilot --yolo"
fi
if command -v cursor-agent &> /dev/null; then
  alias csao="with-op cursor-agent"
  alias csay="cursor-agent --yolo"
  alias csaoy="with-op cursor-agent --yolo"
fi
if command -v cursor &> /dev/null; then
  alias csro="with-op cursor ."
fi
# Codex has no --yolo; its only full skip also turns off the sandbox.
if command -v codex &> /dev/null; then
  alias cdxy="codex --dangerously-bypass-approvals-and-sandbox"
fi
if command -v agy &> /dev/null; then
  alias agyy="agy --dangerously-skip-permissions"
fi

# ==============================================================================
# Wave Terminal: open panes from the shell (macOS and Omarchy)
# ==============================================================================
# Defined only inside Wave, which sets WAVETERM_BLOCKID and puts wsh on PATH. wsh cannot pick a split direction, so
# wsr / wsd press Wave's own split keys: through Hyprland on Omarchy (Alt+D / Alt+Shift+D, only when Wave is the
# active window). Elsewhere (macOS, or a Wave session on another machine) they open a pane where Wave chooses and
# name the key: macOS would need Accessibility permission for Wave to press keys (cheatsheet: "Wave Panes and Tabs").
if [[ -n "${WAVETERM_BLOCKID:-}" ]] && command -v wsh &> /dev/null; then
    wt() { wsh term "$@"; }
    wr() {
        if [[ $# -eq 0 ]]; then
            echo "usage: wr <command> [args...]   (runs it in a new Wave pane)" >&2
            return 2
        fi
        wsh run -- "$@"
    }
    wsplit() {
        local mods key_hint
        case "${1:-}" in
            right) mods="ALT" key_hint="Cmd+D (macOS) / Alt+D (Linux)" ;;
            down) mods="ALT SHIFT" key_hint="Cmd+Shift+D (macOS) / Alt+Shift+D (Linux)" ;;
            *)
                echo "usage: wsplit right|down   (or wsr / wsd)" >&2
                return 2
                ;;
        esac
        if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] && command -v hyprctl &> /dev/null; then
            hyprctl eval "local w = hl.get_active_window()
local c = ((w and w.class) or ''):lower()
if c == 'wave' or c == 'waveterm' then
  hl.dispatch(hl.dsp.send_key_state({ mods = '$mods', key = 'D', state = 'down' }))
  hl.timer(function() hl.dispatch(hl.dsp.send_key_state({ mods = '$mods', key = 'D', state = 'up' })) end, { timeout = 50, type = 'oneshot' })
end" > /dev/null
        else
            wsh term
            echo "Opened a new pane where Wave chose. To split $1: $key_hint" >&2
        fi
    }
    wsr() { wsplit right; }
    wsd() { wsplit down; }
fi

