# AGENTS.md (and CLAUDE.md, its symlink) are instructions for agents working in
# this repo. Deployed to $HOME, Claude Code and cursor-agent load them into every
# session under ~, and ~/CLAUDE.md also stops Claude reading AGENTS.md in repos
# that rely on it. Keep them repo-only.
AGENTS.md
CLAUDE.md
# ~/.bashrc is Claude Code's shell config on macOS only (CLAUDE_CODE_SHELL in ~/.zprofile). Leave the distribution's
# ~/.bashrc alone elsewhere.
{{ if ne .chezmoi.os "darwin" }}
.bashrc
{{ end }}
# Off Omarchy, ~/.config/mise/config.toml carries the shared mise settings itself.
{{ if ne (dig "osRelease" "id" "" .chezmoi) "omarchy" }}
.config/mise/conf.d
.config/mise/conf.d/**
{{ end }}
# Omarchy (/etc/os-release ID=omarchy) ships and updates its own Neovim, Alacritty, Starship and mise configs: leave
# those files alone, and ignore exact files rather than directories so the shared files beside them still deploy.
# tmux and Herdr are not here: they are one shared config, merged from Omarchy's stock files (AGENTS.md 4.2).
# 90_sync_runtimes.sh runs `mise install` for the mise config skipped here.
{{ if eq (dig "osRelease" "id" "" .chezmoi) "omarchy" }}
# Neovim: Omarchy's tree (from the omarchy-nvim package) stays as it is. File patterns, not the directory, so the
# negation below works (gitignore-style negation cannot undo an ignored parent directory): Omarchy gets only
# lua/plugins/shared.lua. tests/host-profiles.sh asserts that nothing else under .config/nvim leaks through.
.config/nvim/**/*.lua
.config/nvim/*.lua
.config/nvim/*.json
.config/nvim/.*.json
.config/nvim/*.toml
!.config/nvim/lua/plugins/shared.lua
.config/alacritty
.config/alacritty/**
.config/starship.toml
# mise: Omarchy owns config.toml (migrations and `omarchy install dev-env` write it) and ships its tools in
# /etc/mise/conf.d. Exact files only, so conf.d/50-shared.toml (the shared settings) still deploys.
.config/mise/config.toml
.config/mise/default-python-packages
90_sync_runtimes.sh
# mise-audit is not wanted on Omarchy.
.local/bin/mise-audit
{{ end }}
