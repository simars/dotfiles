# AGENTS.md (and CLAUDE.md, its symlink) are instructions for agents working in
# this repo. Deployed to $HOME, Claude Code and cursor-agent load them into every
# session under ~, and ~/CLAUDE.md also stops Claude reading AGENTS.md in repos
# that rely on it. Keep them repo-only.
AGENTS.md
CLAUDE.md
# ~/.bashrc is Claude Code's shell config on macOS only (CLAUDE_CODE_SHELL in ~/.zprofile). Leave the distribution's
# ~/.bashrc alone elsewhere.
{{ if ne .chezmoi.os "darwin" }}
.bashrc
{{ end }}
# Omarchy (/etc/os-release ID=omarchy) ships and updates its own Neovim, tmux, Alacritty, Starship and mise configs,
# and herdr there keeps a config this repository never wrote. Leave them all alone. ~/.tmux.conf goes too: tmux reads
# it before ~/.config/tmux/tmux.conf, so it would hide Omarchy's. 90_sync_runtimes.sh runs `mise install` for the
# mise config skipped here.
{{ if eq (dig "osRelease" "id" "" .chezmoi) "omarchy" }}
.config/nvim
.config/nvim/**
.config/tmux
.config/tmux/**
.tmux.conf
.config/alacritty
.config/alacritty/**
.config/starship.toml
.config/mise
.config/mise/**
.config/herdr
.config/herdr/**
90_sync_runtimes.sh
{{ end }}
